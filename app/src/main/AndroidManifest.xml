<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The microphone as the desktop's audio input, also while it is in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The cameras as the desktop's webcams, asked for when a Linux app first films. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The device's storage, mounted in the guest as /sdcard. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Asks to run without battery restrictions: the desktop keeps running in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The session menu's brightness slider is Android's brightness. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidNux">

        <!-- The desktop turns the screen to the orientation chosen in Plasma's
             display settings, which Android 16 ignores on large screens without
             this opt-out (API 36 only). -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The desktop, its display server and its session live in their own
             process: a crash there never takes down the rest of the app.
             Its own task too: the app's icon always leads to the home
             screen, and the desktop is a separate entry in recent apps. -->
        <activity
            android:name=".desktop.DesktopActivity"
            android:exported="false"
            android:process=":desktop"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.desktop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service
            android:name=".desktop.DesktopSessionService"
            android:exported="false"
            android:process=":desktop"
            android:foregroundServiceType="specialUse|microphone|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a Linux desktop session (display server and container) chosen by the user" />
        </service>

        <!-- Keeps the app's process running while it installs (the distro, the desktop, the store's apps). -->
        <service
            android:name=".InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The log a tester shares from Diagnostics (SessionLog). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_paths" />
        </provider>

        <!-- Optional: gives the desktop the keys Android keeps (Meta, Alt+Tab). -->
        <service
            android:name=".desktop.DesktopKeysService"
            android:exported="false"
            android:label="@string/keys_service_label"
            android:process=":desktop"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/desktop_keys_service" />
        </service>
    </application>

</manifest>
