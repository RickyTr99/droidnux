]))
MANAGER, SESSION_IFACE, SEAT_IFACE, USER_IFACE, TIMEDATE, HOSTNAME = NODE.interfaces
PROPS = {MANAGER.name: MANAGER_PROPS, SESSION_IFACE.name: SESSION_PROPS, SEAT_IFACE.name: SEAT_PROPS,
         USER_IFACE.name: USER_PROPS, TIMEDATE.name: TIMEDATE_PROPS, HOSTNAME.name: HOSTNAME_PROPS}

bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)


def changed(path, iface, *names):
    props = PROPS[iface]
    bus.emit_signal(None, path, "org.freedesktop.DBus.Properties", "PropertiesChanged", GLib.Variant(
        "(sa{sv}as)", (iface, {n: GLib.Variant(props[n][0], props[n][1]()) for n in names}, [])))


def write_awake():
    global awake_written
    awake = screen_wanted or any("idle" in i[0].split(":") for i in inhibitors.values())
    if awake == awake_written:
        return
    awake_written = awake
    try:
        with open("@AWAKE_FILE@.new", "w") as f:
            f.write("1\n" if awake else "0\n")
        os.replace("@AWAKE_FILE@.new", "@AWAKE_FILE@")
    except OSError as e:
        print("logind: cannot write @AWAKE_FILE@: %s" % e, flush=True)


def inhibit(invocation, what, who, why, mode):
    if mode not in ("block", "delay", "block-weak"):
        invocation.return_dbus_error("org.freedesktop.DBus.Error.InvalidArgs", "Invalid mode " + mode)
        return
    keep, give = os.pipe2(os.O_CLOEXEC)
    sender = invocation.get_sender()
    pid = uid = 0
    try:
        creds = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                              "GetConnectionUnixProcessID", GLib.Variant("(s)", (sender,)), None,
                              Gio.DBusCallFlags.NONE, -1, None)
        pid = creds.unpack()[0]
        uid = UID
    except GLib.Error:
        pass
    inhibitors[keep] = (what, who, why, "block" if mode == "block-weak" else mode, uid, pid)
    fds = Gio.UnixFDList.new()
    fds.append(give)
    os.close(give)
    invocation.return_value_with_unix_fd_list(GLib.Variant("(h)", (0,)), fds)
    GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, keep, GLib.IOCondition.HUP | GLib.IOCondition.ERR, released)
    changed(BASE, MANAGER.name, "BlockInhibited", "DelayInhibited")
    write_awake()


def released(fd, condition):
    inhibitors.pop(fd, None)
    os.close(fd)
    changed(BASE, MANAGER.name, "BlockInhibited", "DelayInhibited")
    write_awake()
    return False


def leave(marker):
    bus.emit_signal(None, BASE, MANAGER.name, "PrepareForShutdown", GLib.Variant("(b)", (True,)))
    # The app ends (or restarts) the session when it reads this.
    print(marker, flush=True)


def lock(lock_it):
    bus.emit_signal(None, SESSION, SESSION_IFACE.name, "Lock" if lock_it else "Unlock", None)


def method_call(connection, sender, path, iface, method, parameters, invocation):
    global locked
    args = parameters.unpack()
    reply = None
    if iface == MANAGER.name:
        if method in ("GetSession", "GetSessionByPID"):
            if method == "GetSession" and args[0] not in (SESSION_ID, "auto", "self", ""):
                invocation.return_dbus_error("org.freedesktop.login1.NoSuchSession", "No session " + args[0])
                return
            reply = (SESSION,)
        elif method == "GetSeat":
            reply = (SEAT,)
        elif method in ("GetUser", "GetUserByPID"):
            reply = (USER_PATH,)
        elif method == "ListSessions":
            reply = ([(SESSION_ID, UID, USER, "seat0", SESSION)],)
        elif method == "ListSeats":
            reply = ([("seat0", SEAT)],)
        elif method == "ListUsers":
            reply = ([(UID, USER, USER_PATH)],)
        elif method == "ListInhibitors":
            reply = (list(inhibitors.values()),)
        elif method == "Inhibit":
            inhibit(invocation, *args)
            return
        elif method == "PowerOff" or method == "Halt":
            leave("@SESSION_END_MARKER@")
        elif method == "Reboot":
            leave("@SESSION_RESTART_MARKER@")
        elif method in CAN:
            reply = ("yes" if method in ("CanPowerOff", "CanReboot", "CanHalt") else "na",)
        elif method in ("LockSession", "LockSessions", "UnlockSession", "UnlockSessions"):
            lock(method.startswith("Lock"))
        elif method in SLEEP or method.startswith("Terminate"):
            invocation.return_dbus_error(NOT_SUPPORTED, "Android manages this")
            return
    elif iface == SESSION_IFACE.name:
        if method in ("Lock", "Unlock"):
            lock(method == "Lock")
        elif method == "SetLockedHint" and args[0] != locked:
            locked = args[0]
            changed(SESSION, SESSION_IFACE.name, "LockedHint")
        elif method in ("Terminate", "Kill"):
            invocation.return_dbus_error(NOT_SUPPORTED, "Use Log Out")
            return
    elif iface == TIMEDATE.name:
        if method == "ListTimezones":
            reply = (zones(),)
        else:
            invocation.return_dbus_error(NOT_SUPPORTED, ANDROID)
            return
    elif iface == HOSTNAME.name:
        if method == "Describe":
            reply = (json.dumps({n: p[1]() for n, p in HOSTNAME_PROPS.items()}),)
        else:
            invocation.return_dbus_error(NOT_SUPPORTED, "The host name is set in /etc/hostname")
            return
    invocation.return_value(GLib.Variant("(%s)" % "".join(
        a.signature for a in NODE.lookup_interface(iface).lookup_method(method).out_args), reply)
        if reply is not None else None)


def get_property(connection, sender, path, iface, name):
    signature, value = PROPS[iface][name]
    return GLib.Variant(signature, value())


OBJECTS = {
    BASE: [MANAGER], SESSION: [SESSION_IFACE], BASE + "/session/auto": [SESSION_IFACE],
    BASE + "/session/self": [SESSION_IFACE], SEAT: [SEAT_IFACE], BASE + "/seat/auto": [SEAT_IFACE],
    BASE + "/seat/self": [SEAT_IFACE], USER_PATH: [USER_IFACE], BASE + "/user/self": [USER_IFACE],
    "/org/freedesktop/timedate1": [TIMEDATE], "/org/freedesktop/hostname1": [HOSTNAME],
}
for path, ifaces in OBJECTS.items():
    for iface in ifaces:
        bus.register_object(path, iface, method_call, get_property, None)
for name in ("org.freedesktop.login1", "org.freedesktop.timedate1", "org.freedesktop.hostname1"):
    Gio.bus_own_name_on_connection(bus, name, Gio.BusNameOwnerFlags.NONE, None, None)


# Apps keep the screen on through powerdevil (org.freedesktop.ScreenSaver, the portal's Inhibit).
def screen_policy(*_):
    def done(source, result):
        global screen_wanted
        try:
            screen_wanted = source.call_finish(result).unpack()[0]
        except GLib.Error:
            screen_wanted = False
        write_awake()
    session_bus.call("org.kde.Solid.PowerManagement.PolicyAgent", "/org/kde/Solid/PowerManagement/PolicyAgent",
                     "org.kde.Solid.PowerManagement.PolicyAgent", "HasInhibition",
                     GLib.Variant("(u)", (SCREEN_POLICY,)), None, Gio.DBusCallFlags.NONE, -1, None, done)


def policy_agent_gone(*_):
    global screen_wanted
    screen_wanted = False
    write_awake()


session_bus = Gio.bus_get_sync(Gio.BusType.SESSION)
session_bus.signal_subscribe(None, "org.kde.Solid.PowerManagement.PolicyAgent", "InhibitionsChanged",
                             "/org/kde/Solid/PowerManagement/PolicyAgent", None, Gio.DBusSignalFlags.NONE,
                             screen_policy)
Gio.bus_watch_name_on_connection(session_bus, "org.kde.Solid.PowerManagement.PolicyAgent",
                                 Gio.BusNameWatcherFlags.NONE, screen_policy, policy_agent_gone)
write_awake()
GLib.MainLoop().run()
