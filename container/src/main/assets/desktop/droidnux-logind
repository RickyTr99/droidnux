    interface("org.freedesktop.timedate1",
              "SetTime(xbb) SetTimezone(sb) SetLocalRTC(bbb) SetNTP(bb) ListTimezones()as", "", TIMEDATE_PROPS),
    interface("org.freedesktop.hostname1",
              "SetHostname(sb) SetStaticHostname(sb) SetPrettyHostname(sb) SetIconName(sb) SetChassis(sb) "
