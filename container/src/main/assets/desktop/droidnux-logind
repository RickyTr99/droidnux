              "TakeControl(b) ReleaseControl() SetType(s) SetDisplay(s) SetTTY(h) SetBrightness(ssu)",
              "Lock Unlock", SESSION_PROPS),
    interface("org.freedesktop.login1.Seat", "SwitchTo(u) ActivateSession(s)", "", SEAT_PROPS),
