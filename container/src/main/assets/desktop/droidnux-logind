#!/usr/bin/python3
# Written by DroidNux: systemd's logind, timedated and hostnamed on the session's system bus,
# as far as a desktop in an Android app has them. One user, one seat, one session (this one):
# - Plasma's Shut Down ends the session and Restart starts it again (markers on the session's output);
# - inhibitors (systemd-inhibit, powerdevil) work; an idle one, or an app keeping the screen on through
#   powerdevil (video players, browsers, presentations), keeps Android's screen on (@AWAKE_FILE@);
# - Lock reaches the screen locker; loginctl, timedatectl and hostnamectl answer (no setting: Android's).
# No sleep: Android suspends the device, not this session.
import json
import os
import platform
import pwd
import time

from gi.repository import Gio, GLib

BASE = "/org/freedesktop/login1"
SESSION_ID = "1"
SESSION = BASE + "/session/_31"
SEAT = BASE + "/seat/seat0"
UID = os.getuid()
USER = pwd.getpwuid(UID).pw_name
USER_PATH = "%s/user/_%d" % (BASE, UID)
STARTED = int(time.time() * 1e6)
STARTED_MONOTONIC = int(time.monotonic() * 1e6)
SCREEN_POLICY = 4  # powerdevil's ChangeScreenSettings
NOT_SUPPORTED = "org.freedesktop.DBus.Error.NotSupported"
ANDROID = "Android sets this"


def methods(spec):
    """'Name(in)out' items, as D-Bus signatures, to introspection XML."""
    xml = ""
    for item in spec.split():
        name, _, rest = item.partition("(")
        args, _, out = rest.partition(")")
        xml += '<method name="%s">' % name
        for t in split_signature(args):
            xml += '<arg type="%s" direction="in"/>' % t
        for t in split_signature(out):
            xml += '<arg type="%s" direction="out"/>' % t
        xml += "</method>"
    return xml


def split_signature(signature):
    return list(GLib.Variant.split_signature("(%s)" % signature)) if signature else []


def interface(name, method_spec="", signals="", props=None):
    xml = '<interface name="%s">%s' % (name, methods(method_spec))
    for item in signals.split():
        signal, _, args = item.partition("(")
        xml += '<signal name="%s">%s</signal>' % (
            signal, "".join('<arg type="%s"/>' % t for t in split_signature(args.rstrip(")"))))
    for prop, (signature, _) in (props or {}).items():
        xml += '<property name="%s" type="%s" access="read"/>' % (prop, signature)
    return xml + "</interface>"


def os_release(key):
    try:
        with open("/etc/os-release") as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k == key:
                    return v.strip('"')
    except OSError:
        pass
    return ""


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def zones():
    try:
        with open("/usr/share/zoneinfo/tzdata.zi") as f:
            return sorted(line.split()[1] for line in f if line[:2] in ("Z ", "L "))
    except OSError:
        return []


def now_usec():
    return int(time.time() * 1e6)


inhibitors = {}  # read end of the pipe -> (what, who, why, mode, uid, pid)
locked = False
screen_wanted = False  # by an app, through powerdevil
awake_written = None


def inhibited(mode):
    return ":".join(sorted({w for i in inhibitors.values() if i[3] == mode for w in i[0].split(":")}))


