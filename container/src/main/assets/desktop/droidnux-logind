              "Inhibit(ssss)h PowerOff(b) Reboot(b) Halt(b) " + " ".join(s + "(b)" for s in SLEEP) + " "
              + " ".join(c + "()s" for c in CAN) + " "
              "LockSession(s) UnlockSession(s) LockSessions() UnlockSessions() ActivateSession(s) "
              "TerminateSession(s) TerminateUser(u)",
              "PrepareForShutdown(b) PrepareForSleep(b) SessionNew(so) SessionRemoved(so) "
              "UserNew(uo) UserRemoved(uo) SeatNew(so) SeatRemoved(so)", MANAGER_PROPS),
    interface("org.freedesktop.login1.Session",
