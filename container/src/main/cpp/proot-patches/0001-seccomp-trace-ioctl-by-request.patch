From 4a7f944992e388afd0e9499f5e9316e25800fa2e Mon Sep 17 00:00:00 2001
From: RickyTr99 <rickytorre99@gmail.com>
Date: Mon, 19 Oct 2026 02:22:12 +0200
Subject: [PATCH] seccomp: trace ioctl only for the requests PRoot handles

Every ioctl stopped the tracee on entry and exit, which is every GPU
submit and wait made by Mesa's Turnip on KGSL. The filter now traces only
the requests enter.c and exit.c act on (SIOCGIFINDEX, TCSETSF, the four
termios2 requests, FICLONE) and allows the rest at once.

After DroidDeck's 0013-seccomp-ioctl-by-request patch.
---
 src/syscall/seccomp.c | 92 ++++++++++++++++++++++++++++++++++++-------
 1 file changed, 77 insertions(+), 15 deletions(-)

diff --git a/src/syscall/seccomp.c b/src/syscall/seccomp.c
index 30f7258..e9228e9 100644
--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -38,6 +38,8 @@
 #include <stddef.h>        /* offsetof(3), */
 #include <stdint.h>        /* uint*_t, UINT*_MAX, */
 #include <assert.h>        /* assert(3), */
+#include <termios.h>       /* TCSETS, TCGETS2, ..., */
+#include <linux/sockios.h> /* SIOCGIFINDEX, */
 
 #include "syscall/seccomp.h"
 #include "tracee/tracee.h"
@@ -121,13 +123,71 @@ static int add_trace_syscall(struct sock_fprog *program, word_t syscall, int fla
 	return 0;
 }
 
+/**
+ * Append to @program->filter the statements required to notify PRoot
+ * about the ioctl(2) @syscall, with the given @flag, only for the
+ * requests enter.c and exit.c act on.  Every other request, notably
+ * each GPU submit and wait, then runs without a ptrace stop.  This
+ * function returns -errno if an error occurred, otherwise 0.
+ */
+static int add_trace_ioctl(struct sock_fprog *program, word_t syscall, int flag)
+{
+	/* Low 32 bits of the request on little-endian archs; the
+	 * kernel reads it as an unsigned int anyway.  */
+	const size_t request_offset = offsetof(struct seccomp_data, args[1]);
+	int status;
+
+	/* Sanity check.  */
+	if (syscall > UINT32_MAX || request_offset > UINT32_MAX)
+		return -ERANGE;
+
+	#define LENGTH_TRACE_IOCTL 11
+	struct sock_filter statements[LENGTH_TRACE_IOCTL] = {
+		/* Not ioctl: skip this block, the accumulator still
+		 * holds the syscall number.  */
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, LENGTH_TRACE_IOCTL - 1),
+
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, request_offset),
+
+		/* Both outcomes return, so loading the request above
+		 * never confuses the following syscall checks.  */
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, SIOCGIFINDEX,	6, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCSETS + 2 /* TCSETSF */, 5, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCGETS2,		4, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCSETS2,		3, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCSETSW2,		2, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, TCSETSF2,		1, 0),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, _IOW(0x94, 9, int) /* FICLONE */, 0, 1),
+
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag),
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW)
+	};
+
+	DEBUG_FILTER("FILTER:     trace if syscall == %ld and a handled request\n", syscall);
+
+	status = add_statements(program, LENGTH_TRACE_IOCTL, statements);
+	if (status < 0)
+		return status;
+
+	return 0;
+}
+
+/**
+ * Number of statements add_trace_syscall() or add_trace_ioctl() append
+ * for @sysnum.
+ */
+static size_t trace_length(Sysnum sysnum)
+{
+	return sysnum == PR_ioctl ? LENGTH_TRACE_IOCTL : LENGTH_TRACE_SYSCALL;
+}
+
 /**
  * Append to @program->filter the statements that allow anything (if
- * unfiltered).  Note that @nb_traced_syscalls is used to make a
+ * unfiltered).  Note that @nb_trace_statements is used to make a
  * sanity check.  This function returns -errno if an error occurred,
  * otherwise 0.
  */
-static int end_arch_section(struct sock_fprog *program, size_t nb_traced_syscalls)
+static int end_arch_section(struct sock_fprog *program, size_t nb_trace_statements)
 {
 	int status;
 
@@ -144,7 +204,7 @@ static int end_arch_section(struct sock_fprog *program, size_t nb_traced_syscall
 
 	/* Sanity check, see start_arch_section().  */
 	if (   talloc_array_length(program->filter) - program->len
-	    != LENGTH_END_SECTION + nb_traced_syscalls * LENGTH_TRACE_SYSCALL)
+	    != LENGTH_END_SECTION + nb_trace_statements)
 		return -ERANGE;
 
 	return 0;
@@ -152,16 +212,15 @@ static int end_arch_section(struct sock_fprog *program, size_t nb_traced_syscall
 
 /**
  * Append to @program->filter the statements that check the current
- * @architecture.  Note that @nb_traced_syscalls is used to make a
+ * @architecture.  Note that @nb_trace_statements is used to make a
  * sanity check.  This function returns -errno if an error occurred,
  * otherwise 0.
  */
-static int start_arch_section(struct sock_fprog *program, uint32_t arch, size_t nb_traced_syscalls)
+static int start_arch_section(struct sock_fprog *program, uint32_t arch, size_t nb_trace_statements)
 {
 	const size_t arch_offset    = offsetof(struct seccomp_data, arch);
 	const size_t syscall_offset = offsetof(struct seccomp_data, nr);
-	const size_t section_length = LENGTH_END_SECTION +
-					nb_traced_syscalls * LENGTH_TRACE_SYSCALL;
+	const size_t section_length = LENGTH_END_SECTION + nb_trace_statements;
 	int status;
 
 	/* Sanity checks.  */
@@ -191,7 +250,7 @@ static int start_arch_section(struct sock_fprog *program, uint32_t arch, size_t
 	};
 
 	DEBUG_FILTER("FILTER: if arch == %ld, up to %zdth statement\n",
-		arch, nb_traced_syscalls);
+		arch, nb_trace_statements);
 
 	status = add_statements(program, LENGTH_START_SECTION, statements);
 	if (status < 0)
@@ -256,7 +315,7 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 	size_t nb_archs = sizeof(seccomp_archs) / sizeof(SeccompArch);
 
 	struct sock_fprog program = { .len = 0, .filter = NULL };
-	size_t nb_traced_syscalls;
+	size_t nb_trace_statements;
 	size_t i, j, k;
 	int status;
 
@@ -268,19 +327,20 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 	for (i = 0; i < nb_archs; i++) {
 		word_t syscall;
 
-		nb_traced_syscalls = 0;
+		nb_trace_statements = 0;
 
-		/* Pre-compute the number of traced syscalls for this architecture.  */
+		/* Pre-compute the length of the traced syscalls' statements
+		 * for this architecture.  */
 		for (j = 0; j < seccomp_archs[i].nb_abis; j++) {
 			for (k = 0; sysnums[k].value != PR_void; k++) {
 				syscall = detranslate_sysnum(seccomp_archs[i].abis[j], sysnums[k].value);
 				if (syscall != SYSCALL_AVOIDER)
-					nb_traced_syscalls++;
+					nb_trace_statements += trace_length(sysnums[k].value);
 			}
 		}
 
 		/* Filter: if handled architecture */
-		status = start_arch_section(&program, seccomp_archs[i].value, nb_traced_syscalls);
+		status = start_arch_section(&program, seccomp_archs[i].value, nb_trace_statements);
 		if (status < 0)
 			goto end;
 
@@ -292,14 +352,16 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 					continue;
 
 				/* Filter: trace if handled syscall */
-				status = add_trace_syscall(&program, syscall, sysnums[k].flags);
+				status = sysnums[k].value == PR_ioctl
+					? add_trace_ioctl(&program, syscall, sysnums[k].flags)
+					: add_trace_syscall(&program, syscall, sysnums[k].flags);
 				if (status < 0)
 					goto end;
 			}
 		}
 
 		/* Filter: allow untraced syscalls for this architecture */
-		status = end_arch_section(&program, nb_traced_syscalls);
+		status = end_arch_section(&program, nb_trace_statements);
 		if (status < 0)
 			goto end;
 	}
