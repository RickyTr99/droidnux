From 7b02398adaa479f128a36bc4096b133a0fe904a7 Mon Sep 17 00:00:00 2001
From: RickyTr99 <rickytorre99@gmail.com>
Date: Mon, 19 Oct 2026 19:45:08 +0200
Subject: [PATCH] seccomp: trace close and sendto only where PRoot acts on them

close stopped every tracee on entry: Firefox decoding video in hardware
(VA-API) closes ~20 dma-bufs and eventfds per frame, ~4300 stops per
second that cost about half a core. PRoot acts on close only for
netlink sockets (forgetting their fd) and pipe read ends (shadow
references against EPIPE in process substitution); auxv_fd is followed
in PTRACE_SYSCALL mode anyway. close leaves the base filter: the
per-fd filter of netlink sockets covers it, and pipe2 now stops at exit
to give the read end a per-fd filter on close, dup, dup2, dup3 and
fcntl, whose duplicates (F_DUPFD) get one too, as shells move pipe ends
before closing them.

sendto stopped every tracee too, while PRoot acts on it only with a
destination address or on netlink sockets. A second base filter traces
it natively only when its address argument is set; netlink sockets'
per-fd filter covers the rest. The other ABIs, which per-fd filters
don't cover, keep tracing close and sendto.
---
 src/syscall/enter.c       | 14 ++++++++
 src/syscall/exit.c        | 75 +++++++++++++++++++++++++++++++--------
 src/syscall/pipe_shadow.c | 29 ++++++++++-----
 src/syscall/pipe_shadow.h |  2 ++
 src/syscall/seccomp.c     | 63 ++++++++++++++++++++++++++++++--
 src/tracee/tracee.c       |  1 +
 src/tracee/tracee.h       |  1 +
 7 files changed, 158 insertions(+), 27 deletions(-)

diff --git a/src/syscall/enter.c b/src/syscall/enter.c
index 0eed12f..30225de 100644
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -3058,6 +3058,20 @@ int translate_syscall_enter(Tracee *tracee)
 			}
 			break;
 		}
+	case PR_dup:
+	case PR_dup2:
+	case PR_dup3:
+	case PR_fcntl:
+		/* Stopped only on traced pipe read ends (see
+		 * trace_pipe_read_end): a duplicate is one too.  */
+		if (   syscall_number != PR_fcntl
+		    || peek_reg(tracee, CURRENT, SYSARG_2) == F_DUPFD
+		    || peek_reg(tracee, CURRENT, SYSARG_2) == F_DUPFD_CLOEXEC) {
+			tracee->sysexit_pending = true;
+			tracee->restart_how = PTRACE_SYSCALL;
+		}
+		break;
+
 	case PR_close: {
 		int closed_fd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
 
diff --git a/src/syscall/exit.c b/src/syscall/exit.c
index eb9c35c..bf176b7 100644
--- a/src/syscall/exit.c
+++ b/src/syscall/exit.c
@@ -52,12 +52,15 @@
 #include "ptrace/wait.h"
 #include "extension/extension.h"
 #include "arch.h"
+#include "syscall/pipe_shadow.h"
 
 /**
- * recvfrom(2), recvmsg(2) and sendmsg(2) are not in PRoot's seccomp
- * filter: they are the bulk of every IPC and X11 client's syscalls, and
- * PRoot acts on them only for some sockets.  Make the @tracee's process
- * stop on the @count syscalls @sysnums for the socket @fd it just got, by
+ * recvfrom(2), recvmsg(2), sendmsg(2) and close(2) are not in PRoot's
+ * seccomp filter: they are the bulk of every IPC and X11 client's
+ * syscalls (and Firefox closes the dma-bufs and eventfds it passes
+ * around for each video frame), while PRoot acts on them only for some
+ * fds.  Make the @tracee's process
+ * stop on the @count syscalls @sysnums for the fd @fd it just got, by
  * chaining a seccomp(2) call that adds a filter for that fd to all its
  * threads; children inherit it.  A later socket reusing the fd number
  * only costs useless stops.  @traced remembers the fds already covered,
@@ -68,17 +71,29 @@
 static void trace_socket_fd(Tracee *tracee, int fd, const Sysnum *sysnums, int count, uint64_t *traced)
 {
 	SeccompArch seccomp_archs[] = SECCOMP_ARCHS;
-	struct sock_filter filter[4 + 3 + 3];
+	struct sock_filter filter[4 + 5 + 3];
 	struct sock_fprog program;
+	word_t nrs[5];
 	word_t address;
 	int status;
-	int i, n = 0;
+	int i, n;
 
-	if (fd < 0 || count > 3 || detranslate_sysnum(get_abi(tracee), PR_seccomp) == SYSCALL_AVOIDER)
+	if (fd < 0 || count > 5 || detranslate_sysnum(get_abi(tracee), PR_seccomp) == SYSCALL_AVOIDER)
 		return;
 	if (fd < MAX_TRACED_SOCKET_FDS && (traced[fd / 64] & (1ULL << (fd % 64))) != 0)
 		return;
 
+	/* Some syscalls don't exist on every ABI (dup2(2) on arm64).  */
+	for (i = 0, n = 0; i < count; i++) {
+		word_t nr = detranslate_sysnum(get_abi(tracee), sysnums[i]);
+		if (nr != SYSCALL_AVOIDER)
+			nrs[n++] = nr;
+	}
+	if (n == 0)
+		return;
+	count = n;
+	n = 0;
+
 	/* if (arch == native && (nr == sysnums[0] || ...) && args[0] == fd)
 	 *	return TRACE;
 	 * return ALLOW;
@@ -87,11 +102,8 @@ static void trace_socket_fd(Tracee *tracee, int fd, const Sysnum *sysnums, int c
 	filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, seccomp_archs[0].value, 0, count + 3);
 	filter[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, nr));
 	for (i = 0; i < count; i++) {
-		word_t nr = detranslate_sysnum(get_abi(tracee), sysnums[i]);
-		if (nr == SYSCALL_AVOIDER)
-			return;
 		/* Match: on to the fd check; no match on the last: allow.  */
-		filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, nr, count - 1 - i, i == count - 1 ? 2 : 0);
+		filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, nrs[i], count - 1 - i, i == count - 1 ? 2 : 0);
 	}
 	filter[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, args[0]));
 	filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, (uint32_t) fd, 1, 0);
@@ -119,10 +131,21 @@ static void trace_socket_fd(Tracee *tracee, int fd, const Sysnum *sysnums, int c
 	if (fd < MAX_TRACED_SOCKET_FDS)
 		traced[fd / 64] |= 1ULL << (fd % 64);
 
-	/* The tracee gets its socket, not seccomp's result.  */
+	/* The tracee gets its syscall's result, not seccomp's.  */
 	force_chain_final_result(tracee, peek_reg(tracee, CURRENT, SYSARG_RESULT));
 }
 
+/**
+ * The read end of a pipe, @fd, gets PRoot's attention when it is closed
+ * (see shadow_pipe_read_end) and when it is duplicated, as shells move
+ * pipe ends to other fds before closing them.
+ */
+static void trace_pipe_read_end(Tracee *tracee, int fd)
+{
+	static const Sysnum pipe_sysnums[] = { PR_close, PR_dup, PR_dup2, PR_dup3, PR_fcntl };
+	trace_socket_fd(tracee, fd, pipe_sysnums, 5, tracee->traced_pipe_fds);
+}
+
 /**
  * Translate the output arguments of the current @tracee's syscall in
  * the @tracee->pid process area. This function sets the result of
@@ -862,12 +885,34 @@ void translate_syscall_exit(Tracee *tracee)
 		}
 		goto end;
 
+	case PR_pipe:
+	case PR_pipe2: {
+		int fds[2];
+		if ((int) peek_reg(tracee, CURRENT, SYSARG_RESULT) == 0
+		    && read_data(tracee, fds, peek_reg(tracee, ORIGINAL, SYSARG_1), sizeof(fds)) == 0)
+			trace_pipe_read_end(tracee, fds[0]);
+		goto end;
+	}
+
+	case PR_dup:
+	case PR_dup2:
+	case PR_dup3:
+	case PR_fcntl: {
+		/* Stopped only on traced pipe read ends, and at exit only
+		 * when duplicating them (see enter.c).  */
+		int fd = (int) peek_reg(tracee, CURRENT, SYSARG_RESULT);
+		if (fd >= 0 && is_pipe_read_end(tracee->pid, fd))
+			trace_pipe_read_end(tracee, fd);
+		goto end;
+	}
+
 	case PR_socket:
 		if (tracee->pending_fake_netlink_socket || tracee->pending_real_netlink_socket) {
-			/* Emulated replies and namespace acks.  */
-			static const Sysnum netlink_sysnums[] = { PR_recvfrom, PR_recvmsg, PR_sendmsg };
+			/* Emulated replies and namespace acks, and the fd
+			 * forgotten once closed.  */
+			static const Sysnum netlink_sysnums[] = { PR_recvfrom, PR_recvmsg, PR_sendmsg, PR_sendto, PR_close };
 			trace_socket_fd(tracee, (int) peek_reg(tracee, CURRENT, SYSARG_RESULT),
-					netlink_sysnums, 3, tracee->traced_netlink_fds);
+					netlink_sysnums, 5, tracee->traced_netlink_fds);
 		}
 		else if (tracee->pending_unix_socket) {
 			/* msg_name of datagrams.  */
diff --git a/src/syscall/pipe_shadow.c b/src/syscall/pipe_shadow.c
index 3ddb1cc..8ce6f9a 100644
--- a/src/syscall/pipe_shadow.c
+++ b/src/syscall/pipe_shadow.c
@@ -162,7 +162,11 @@ static bool writer_would_block(int fd)
 	return buffered > (capacity > PIPE_BUF ? capacity - PIPE_BUF : 0);
 }
 
-void shadow_pipe_read_end(pid_t tracee_pid, int tracee_fd)
+/**
+ * Return true when @tracee_fd of @tracee_pid is the read end of an
+ * anonymous pipe.
+ */
+bool is_pipe_read_end(pid_t tracee_pid, int tracee_fd)
 {
 	char path[64];
 	char link[32];
@@ -170,25 +174,21 @@ void shadow_pipe_read_end(pid_t tracee_pid, int tracee_fd)
 	ssize_t len;
 	unsigned long flags;
 	FILE *f;
-	int shadow_fd;
-	int i;
-
-	ensure_init();
 
 	/* Check the fd is an anonymous pipe. */
 	snprintf(path, sizeof(path), "/proc/%d/fd/%d", tracee_pid, tracee_fd);
 	len = readlink(path, link, sizeof(link) - 1);
 	if (len < 0)
-		return;
+		return false;
 	link[len] = '\0';
 	if (strncmp(link, "pipe:[", 6) != 0)
-		return;
+		return false;
 
 	/* Confirm it is the read end (flags O_RDONLY = 0 in O_ACCMODE). */
 	snprintf(path, sizeof(path), "/proc/%d/fdinfo/%d", tracee_pid, tracee_fd);
 	f = fopen(path, "r");
 	if (!f)
-		return;
+		return false;
 	flags = 1; /* default: not O_RDONLY */
 	while (fgets(line, sizeof(line), f)) {
 		if (strncmp(line, "flags:", 6) == 0) {
@@ -197,7 +197,18 @@ void shadow_pipe_read_end(pid_t tracee_pid, int tracee_fd)
 		}
 	}
 	fclose(f);
-	if ((flags & O_ACCMODE) != O_RDONLY)
+	return (flags & O_ACCMODE) == O_RDONLY;
+}
+
+void shadow_pipe_read_end(pid_t tracee_pid, int tracee_fd)
+{
+	char path[64];
+	int shadow_fd;
+	int i;
+
+	ensure_init();
+
+	if (!is_pipe_read_end(tracee_pid, tracee_fd))
 		return;
 
 	/* Find a free slot. */
diff --git a/src/syscall/pipe_shadow.h b/src/syscall/pipe_shadow.h
index b113380..15c5af9 100644
--- a/src/syscall/pipe_shadow.h
+++ b/src/syscall/pipe_shadow.h
@@ -39,6 +39,8 @@
  */
 void shadow_pipe_read_end(pid_t tracee_pid, int tracee_fd);
 
+bool is_pipe_read_end(pid_t tracee_pid, int tracee_fd);
+
 /**
  * Close any shadow fd that has become useless — no writer is left
  * (POLLHUP), the pipe is too full for a writer to make progress, or
diff --git a/src/syscall/seccomp.c b/src/syscall/seccomp.c
index 1879820..be31b70 100644
--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -309,6 +309,61 @@ static void free_program_filter(struct sock_fprog *program)
  *
  * This function returns -errno if an error occurred, otherwise 0.
  */
+/**
+ * sendto(2) concerns PRoot only with a destination address (Unix socket
+ * paths) or on netlink sockets (traced per fd, see trace_socket_fd()),
+ * while X11 and D-Bus clients call it without one all the time: trace
+ * it in the native ABI only with an address.  The other ABIs, which
+ * per-fd filters don't cover, keep tracing close(2) and sendto(2).
+ */
+static int set_sendto_filter(void)
+{
+	SeccompArch seccomp_archs[] = SECCOMP_ARCHS;
+	size_t nb_archs = sizeof(seccomp_archs) / sizeof(SeccompArch);
+	struct sock_filter filter[11 + 6 * 4];
+	struct sock_fprog program;
+	word_t sendto_nr = detranslate_sysnum(seccomp_archs[0].abis[0], PR_sendto);
+	size_t i, n = 0;
+
+	if (sendto_nr == SYSCALL_AVOIDER || nb_archs > 5)
+		return -ENOSYS;
+
+	/* if (arch == native) {
+	 *	if (nr == sendto && args[4] != 0)
+	 *		return TRACE;
+	 *	return ALLOW;
+	 * }  */
+	filter[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, arch));
+	filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, seccomp_archs[0].value, 0, 8);
+	filter[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, nr));
+	filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, sendto_nr, 0, 4);
+	filter[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, args[4]));
+	filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, 0, 0, 3);
+	filter[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, args[4]) + 4);
+	filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, 0, 0, 1);
+	filter[n++] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW);
+	filter[n++] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE);
+
+	for (i = 1; i < nb_archs; i++) {
+		word_t close_nr = detranslate_sysnum(seccomp_archs[i].abis[0], PR_close);
+		word_t other_sendto_nr = detranslate_sysnum(seccomp_archs[i].abis[0], PR_sendto);
+
+		/* if (arch == other && (nr == close || nr == sendto))
+		 *	return TRACE;  */
+		filter[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, arch));
+		filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, seccomp_archs[i].value, 0, 4);
+		filter[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, offsetof(struct seccomp_data, nr));
+		filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, close_nr, 1, 0);
+		filter[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, other_sendto_nr, 0, 1);
+		filter[n++] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE);
+	}
+	filter[n++] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW);
+
+	program.len = n;
+	program.filter = filter;
+	return prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &program) < 0 ? -errno : 0;
+}
+
 static int set_seccomp_filters(const FilteredSysnum *sysnums)
 {
 	SeccompArch seccomp_archs[] = SECCOMP_ARCHS;
@@ -383,7 +438,7 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 	if (status < 0)
 		goto end;
 
-	status = 0;
+	status = set_sendto_filter();
 end:
 	free_program_filter(&program);
 	return status;
@@ -404,13 +459,15 @@ static FilteredSysnum proot_sysnums[] = {
 	{ PR_chroot,		0 },
 	{ PR_clone,		0 },
 	{ PR_clone3,		0 },
-	{ PR_close,		0 },
+	/* PR_close: traced only on some fds, see trace_socket_fd().  */
 	{ PR_connect,		0 },
 	{ PR_creat,		0 },
 	/* PR_recvfrom, PR_recvmsg and PR_sendmsg are traced only on
 	 * some sockets, see trace_socket_fd().  */
 	{ PR_sendmmsg,		0 },
-	{ PR_sendto,		0 },
+	/* PR_sendto: see set_sendto_filter().  */
+	{ PR_pipe,		FILTER_SYSEXIT },
+	{ PR_pipe2,		FILTER_SYSEXIT },
 	{ PR_socket,		FILTER_SYSEXIT },
 	{ PR_execve,		FILTER_SYSEXIT },
 	{ PR_execveat,		FILTER_SYSEXIT },
diff --git a/src/tracee/tracee.c b/src/tracee/tracee.c
index dc37934..e2c7e77 100644
--- a/src/tracee/tracee.c
+++ b/src/tracee/tracee.c
@@ -683,6 +683,7 @@ static int attach_child(Tracee *parent, word_t clone_flags, pid_t pid)
 	child->no_new_privs = parent->no_new_privs;
 	memcpy(child->traced_netlink_fds, parent->traced_netlink_fds, sizeof(child->traced_netlink_fds));
 	memcpy(child->traced_unix_fds, parent->traced_unix_fds, sizeof(child->traced_unix_fds));
+	memcpy(child->traced_pipe_fds, parent->traced_pipe_fds, sizeof(child->traced_pipe_fds));
 	child->seen_execve = parent->seen_execve;
 #ifdef HAS_POKEDATA_WORKAROUND
 	child->pokedata_workaround_stub_addr = parent->pokedata_workaround_stub_addr;
diff --git a/src/tracee/tracee.h b/src/tracee/tracee.h
index cdf8c48..41c43b7 100644
--- a/src/tracee/tracee.h
+++ b/src/tracee/tracee.h
@@ -165,6 +165,7 @@ typedef struct tracee {
 #define MAX_TRACED_SOCKET_FDS 1024
 	uint64_t traced_netlink_fds[MAX_TRACED_SOCKET_FDS / 64];
 	uint64_t traced_unix_fds[MAX_TRACED_SOCKET_FDS / 64];
+	uint64_t traced_pipe_fds[MAX_TRACED_SOCKET_FDS / 64];
 	bool pending_unix_socket;
 	bool netlink_ack_pending;
 	int netlink_ack_fd;
-- 
