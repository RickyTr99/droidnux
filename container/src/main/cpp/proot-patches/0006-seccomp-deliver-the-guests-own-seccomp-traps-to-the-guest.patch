From 908d0aa189c760645a585a39f4ec632ce006eec6 Mon Sep 17 00:00:00 2001
From: RickyTr99 <rickytorre99@gmail.com>
Date: Tue, 20 Oct 2026 16:16:05 +0200
Subject: [PATCH] seccomp: deliver the guest's own seccomp traps to the guest

Android's app seccomp policy traps with a bare SECCOMP_RET_TRAP
(si_errno 0). A SIGSYS with non-zero SECCOMP_RET_DATA comes from a
filter the guest installed itself, such as the Firefox and Chromium
sandboxes, whose SIGSYS handler emulates the syscall (Firefox brokers
its file opens this way). PRoot emulated those as if Android had
trapped them and answered -ENOSYS, so Firefox's sandboxed content
processes could open no font and crashed.
---
 src/tracee/event.c   | 12 ++++++++++++
 src/tracee/seccomp.c | 28 ++++++++++++++++++++++++++++
 src/tracee/seccomp.h |  1 +
 3 files changed, 41 insertions(+)

diff --git a/src/tracee/event.c b/src/tracee/event.c
index c8dd9e4..97a8d2d 100644
--- a/src/tracee/event.c
+++ b/src/tracee/event.c
@@ -866,6 +866,18 @@ int handle_tracee_event(Tracee *tracee, int tracee_status)
 					tracee->skip_next_seccomp_signal = false;
 					tracee->restore_sysarg1_after_sigsys = false;
 					signal = 0;
+				} else if (siginfo.si_errno != 0) {
+					/* Android's app seccomp policy traps with a bare
+					 * SECCOMP_RET_TRAP, so si_errno (the filter's
+					 * SECCOMP_RET_DATA) is 0.  A non-zero value comes
+					 * from a filter the guest installed itself, e.g.
+					 * the Firefox and Chromium sandboxes, which use it
+					 * as the trap id and emulate the syscall in their
+					 * own SIGSYS handler (Firefox brokers its file
+					 * opens this way).  Deliver it to that handler:
+					 * emulating it here would answer -ENOSYS.  */
+					VERBOSE(tracee, 2, "guest seccomp SIGSYS (data %d)", siginfo.si_errno);
+					signal = deliver_guest_seccomp_signal(tracee);
 				} else {
 					signal = handle_seccomp_event(tracee);
 				}
diff --git a/src/tracee/seccomp.c b/src/tracee/seccomp.c
index cd3260b..3bf22c1 100644
--- a/src/tracee/seccomp.c
+++ b/src/tracee/seccomp.c
@@ -117,6 +117,34 @@ int handle_seccomp_event(Tracee* tracee)
 	return handle_seccomp_event_common(tracee);
 }
 
+/**
+ * Prepare the delivery of a SIGSYS raised by a seccomp filter the guest
+ * installed itself, so that the guest's own handler emulates the syscall.
+ *
+ * Returns SIGSYS (the signal to deliver).
+ */
+int deliver_guest_seccomp_signal(Tracee* tracee)
+{
+	/* The syscall was cancelled: the next SIGTRAP | 0x80 is an entry.  */
+	tracee->status = 0;
+	tracee->restore_original_regs = false;
+
+#if defined(ARCH_ARM_EABI) || defined(ARCH_ARM64)
+	/* The guest's handler reads the syscall arguments from the signal
+	 * context: undo the clobbering of SYSARG_1 by a synthesized sysexit
+	 * (see handle_seccomp_event).  */
+	if (tracee->restore_sysarg1_after_sigsys
+	    && fetch_regs(tracee) == 0
+	    && get_sysnum(tracee, ORIGINAL) == get_sysnum(tracee, CURRENT)) {
+		poke_reg(tracee, SYSARG_1, peek_reg(tracee, ORIGINAL, SYSARG_1));
+		push_specific_regs(tracee, false);
+	}
+#endif
+	tracee->restore_sysarg1_after_sigsys = false;
+
+	return SIGSYS;
+}
+
 void fix_and_restart_enosys_syscall(Tracee* tracee)
 {
 	/* Reset tracee state so we're not handling syscall exit */
diff --git a/src/tracee/seccomp.h b/src/tracee/seccomp.h
index 1e0815b..9c542e9 100644
--- a/src/tracee/seccomp.h
+++ b/src/tracee/seccomp.h
@@ -19,4 +19,5 @@ struct compat_statfs {
 void restart_syscall_after_seccomp(Tracee* tracee);
 void set_result_after_seccomp(Tracee *tracee, word_t result);
 int handle_seccomp_event(Tracee* tracee);
+int deliver_guest_seccomp_signal(Tracee* tracee);
 void fix_and_restart_enosys_syscall(Tracee* tracee);
-- 
