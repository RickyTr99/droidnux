From b7d1498b34ef404ef15aca3e954aab10e1a2a56b Mon Sep 17 00:00:00 2001
From: RickyTr99 <rickytorre99@gmail.com>
Date: Tue, 20 Oct 2026 16:53:47 +0200
Subject: [PATCH] Never let the guest block SIGSYS

A seccomp SIGSYS is forced: when the guest blocks it, the kernel resets
its handler to SIG_DFL instead of deferring it. Android's app policy
traps clone3, which glibc's pthread_create() calls with every signal
blocked, so the guest's own SIGSYS handler (the Firefox and Chromium
sandboxes) vanished and the next trap of its own filter killed it.
SIGSYS is only raised synchronously: drop it from the sets given to
rt_sigprocmask(2), traced only when it may block signals.
---
 src/syscall/enter.c   | 27 +++++++++++++++
 src/syscall/seccomp.c | 77 +++++++++++++++++++++++++++++++++++++++----
 2 files changed, 98 insertions(+), 6 deletions(-)

diff --git a/src/syscall/enter.c b/src/syscall/enter.c
index 711f831..9a6c035 100644
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -45,6 +45,7 @@
 #include <netpacket/packet.h> /* struct sockaddr_ll (AF_PACKET) */
 #include <sys/ioctl.h>   /* ioctl(2): SIOCGIFMTU / SIOCGIFHWADDR */
 #include <sys/time.h>    /* struct timeval, for SO_RCVTIMEO */
+#include <signal.h>      /* SIGSYS, SIG_UNBLOCK */
 #include "syscall/pipe_shadow.h"
 
 /* ABI-stable rtnetlink constants we synthesise for the loopback reply.
@@ -2994,6 +2995,32 @@ int translate_syscall_enter(Tracee *tracee)
 		}
 		break;
 
+	case PR_rt_sigprocmask: {
+		/* A seccomp SIGSYS is forced: if the guest blocks it, the
+		 * kernel resets its handler to SIG_DFL instead of deferring
+		 * it.  Android's app policy traps clone3, which glibc's
+		 * pthread_create() calls with every signal blocked, so the
+		 * guest's own SIGSYS handler (the Firefox and Chromium
+		 * sandboxes) would vanish and the next trap of its own
+		 * filter would kill it.  SIGSYS is only raised
+		 * synchronously, so never let the guest block it (Firefox
+		 * does the same in its libc wrappers).  */
+		word_t how = peek_reg(tracee, CURRENT, SYSARG_1);
+		word_t set_addr = peek_reg(tracee, CURRENT, SYSARG_2);
+		uint64_t set;
+
+		if (how == SIG_UNBLOCK || set_addr == 0
+		    || peek_reg(tracee, CURRENT, SYSARG_4) != sizeof(set)
+		    || read_data(tracee, &set, set_addr, sizeof(set)) < 0
+		    || (set & (1ULL << (SIGSYS - 1))) == 0)
+			break;
+
+		set &= ~(1ULL << (SIGSYS - 1));
+		/* On failure the call just runs unchanged.  */
+		(void) set_sysarg_data(tracee, &set, sizeof(set), SYSARG_2);
+		break;
+	}
+
 	case PR_ioctl: {
 		word_t cmd = peek_reg(tracee, CURRENT, SYSARG_2);
 		word_t arg = peek_reg(tracee, CURRENT, SYSARG_3);
diff --git a/src/syscall/seccomp.c b/src/syscall/seccomp.c
index ff788db..49de2e0 100644
--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -40,6 +40,7 @@
 #include <assert.h>        /* assert(3), */
 #include <termios.h>       /* TCSETS, TCGETS2, ..., */
 #include <linux/sockios.h> /* SIOCGIFINDEX, */
+#include <signal.h>        /* SIG_UNBLOCK, */
 
 #include "syscall/seccomp.h"
 #include "tracee/tracee.h"
@@ -173,12 +174,65 @@ static int add_trace_ioctl(struct sock_fprog *program, word_t syscall, int flag)
 }
 
 /**
- * Number of statements add_trace_syscall() or add_trace_ioctl() append
- * for @sysnum.
+ * Append to @program->filter the statements required to notify PRoot
+ * about the rt_sigprocmask(2) @syscall, with the given @flag, only
+ * when it may block signals: SIG_UNBLOCK and queries (no new set) run
+ * without a ptrace stop.  See the PR_rt_sigprocmask case in enter.c.
+ * This function returns -errno if an error occurred, otherwise 0.
+ */
+static int add_trace_sigprocmask(struct sock_fprog *program, word_t syscall, int flag)
+{
+	/* Little-endian archs: the low half of each argument first.  */
+	const size_t how_offset = offsetof(struct seccomp_data, args[0]);
+	const size_t set_offset = offsetof(struct seccomp_data, args[1]);
+	int status;
+
+	/* Sanity check.  */
+	if (syscall > UINT32_MAX || set_offset + 4 > UINT32_MAX)
+		return -ERANGE;
+
+	#define LENGTH_TRACE_SIGPROCMASK 9
+	struct sock_filter statements[LENGTH_TRACE_SIGPROCMASK] = {
+		/* Not rt_sigprocmask: skip this block, the accumulator
+		 * still holds the syscall number.  */
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, LENGTH_TRACE_SIGPROCMASK - 1),
+
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, how_offset),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, SIG_UNBLOCK, 5, 0),
+
+		/* A NULL set only queries the mask.  */
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, set_offset),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, 0, 0, 2),
+		BPF_STMT(BPF_LD + BPF_W + BPF_ABS, set_offset + 4),
+		BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, 0, 1, 0),
+
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag),
+		BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW)
+	};
+
+	DEBUG_FILTER("FILTER:     trace if syscall == %ld and it may block signals\n", syscall);
+
+	status = add_statements(program, LENGTH_TRACE_SIGPROCMASK, statements);
+	if (status < 0)
+		return status;
+
+	return 0;
+}
+
+/**
+ * Number of statements add_trace_syscall(), add_trace_ioctl() or
+ * add_trace_sigprocmask() append for @sysnum.
  */
 static size_t trace_length(Sysnum sysnum)
 {
-	return sysnum == PR_ioctl ? LENGTH_TRACE_IOCTL : LENGTH_TRACE_SYSCALL;
+	switch (sysnum) {
+	case PR_ioctl:
+		return LENGTH_TRACE_IOCTL;
+	case PR_rt_sigprocmask:
+		return LENGTH_TRACE_SIGPROCMASK;
+	default:
+		return LENGTH_TRACE_SYSCALL;
+	}
 }
 
 /**
@@ -407,9 +461,17 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 					continue;
 
 				/* Filter: trace if handled syscall */
-				status = sysnums[k].value == PR_ioctl
-					? add_trace_ioctl(&program, syscall, sysnums[k].flags)
-					: add_trace_syscall(&program, syscall, sysnums[k].flags);
+				switch (sysnums[k].value) {
+				case PR_ioctl:
+					status = add_trace_ioctl(&program, syscall, sysnums[k].flags);
+					break;
+				case PR_rt_sigprocmask:
+					status = add_trace_sigprocmask(&program, syscall, sysnums[k].flags);
+					break;
+				default:
+					status = add_trace_syscall(&program, syscall, sysnums[k].flags);
+					break;
+				}
 				if (status < 0)
 					goto end;
 			}
@@ -532,6 +594,9 @@ static FilteredSysnum proot_sysnums[] = {
 	{ PR_renameat,		FILTER_SYSEXIT },
 	{ PR_renameat2,		FILTER_SYSEXIT },
 	{ PR_rmdir,		0 },
+	/* PR_rt_sigprocmask: traced only when it may block signals,
+	 * see add_trace_sigprocmask().  */
+	{ PR_rt_sigprocmask,	0 },
 	{ PR_setrlimit,		FILTER_SYSEXIT },
 	{ PR_setxattr,		0 },
 	{ PR_socketcall,	FILTER_SYSEXIT },
-- 
