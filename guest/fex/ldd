#!/bin/sh
# ldd that also lists x86 programs' libraries (Steam checks its own with it), linked as
# /usr/local/bin/ldd by the FEX component. Debian's arm64 ldd only knows the arm64 loader, and its
# LD_TRACE_LOADED_OBJECTS would reach FEX's own loader; ld.so --list reaches the program's.
if [ $# -eq 1 ] && [ -f "$1" ] && [ "$(head -c 4 "$1")" = "$(printf '\177ELF')" ]; then
    # ld.so takes a name without a slash for a library to look up.
    case $1 in */*) f=$1 ;; *) f=./$1 ;; esac
    case $(od -An -tx1 -j 18 -N 1 "$f") in
        *3e) exec /lib64/ld-linux-x86-64.so.2 --list "$f" ;;
        *03) exec /lib/ld-linux.so.2 --list "$f" ;;
    esac
fi
exec /usr/bin/ldd "$@"
