FEXServer outlives the program that starts it, so it must not keep that
program's standard streams: when they are the write end of a pipe someone
reads to EOF, the reader waits for FEXServer forever. Steam does this: its
srt-logger, the first x86 program, runs with stdout on a FIFO that steam.sh
reads until it closes.

--- a/Source/Common/FEXServerClient.cpp
+++ b/Source/Common/FEXServerClient.cpp
@@ -313,6 +313,15 @@

     argv[arg_count++] = nullptr;

+    int null_fd = open("/dev/null", O_RDWR);
+    if (null_fd != -1) {
+      dup2(null_fd, STDIN_FILENO);
+      dup2(null_fd, STDOUT_FILENO);
+      dup2(null_fd, STDERR_FILENO);
+      if (null_fd > STDERR_FILENO) {
+        close(null_fd);
+      }
+    }
     if (execvp(argv[0], (char* const*)argv) == -1) {
       // Let the parent know that we couldn't execute for some reason
       uint64_t error {1};
