+// A thunked library at its path in the RootFS, or by its file name anywhere else: Chromium, Electron
+// and games load their own copy of the Vulkan loader (RPATH $ORIGIN), which would only find the ICDs
+// of host drivers it cannot load.
+const fextl::string* FileManager::FindThunkOverlay(std::string_view Path) const {
+  auto Overlay = ThunkOverlays.find(Path);
+  if (Overlay != ThunkOverlays.end()) {
+    return &Overlay->second;
+  }
+  auto Name = ThunkLibraryNames.find(Path.substr(Path.rfind('/') + 1));
+  return Name != ThunkLibraryNames.end() ? &Name->second : nullptr;
+}
