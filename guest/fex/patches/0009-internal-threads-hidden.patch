+// This process' status and stat (also per thread, under task/<tid>/) count FEX's internal threads,
+// which the guest never created.
+// shortcut: the guest reads a snapshot from open time, not a fresh one per read; matters only to a guest re-reading one open fd.
+int32_t EmulatedFDManager::ProcThreadCount(const char* pathname, int flags) {
+  const uint32_t Internal = FEX::LinuxEmulation::Threads::InternalThreadCount();
+  if (Internal == 0) {
+    return -1;
+  }
+
+  std::string_view Path {pathname};
+  const auto Prefix = fextl::fmt::format("/proc/{}/", ::getpid());
+  if (!Path.starts_with(Prefix)) {
+    return -1;
+  }
+  Path.remove_prefix(Prefix.size());
+  if (Path.starts_with("task/")) {
+    Path.remove_prefix(strlen("task/"));
+    const auto Slash = Path.find('/');
+    if (Slash == 0 || Slash == std::string_view::npos || Path.substr(0, Slash).find_first_not_of("0123456789") != std::string_view::npos) {
+      return -1;
+    }
+    Path.remove_prefix(Slash + 1);
+  }
+  const bool Status = Path == "status";
+  if (!Status && Path != "stat") {
+    return -1;
+  }
+
+  char Buffer[4096];
+  const int Real = ::open(pathname, O_RDONLY | O_CLOEXEC);
+  if (Real == -1) {
+    return -1;
+  }
+  const ssize_t Size = ::read(Real, Buffer, sizeof(Buffer));
+  ::close(Real);
+  if (Size <= 0 || Size == sizeof(Buffer)) {
+    return -1;
+  }
+  const std::string_view Content {Buffer, static_cast<size_t>(Size)};
+
+  size_t Start {};
+  if (Status) {
+    constexpr std::string_view Key = "\nThreads:\t";
+    Start = Content.find(Key);
+    if (Start == std::string_view::npos) {
+      return -1;
+    }
+    Start += Key.size();
+  } else {
+    // Field 20 (num_threads); fields 3 onwards follow the last ')', since comm can hold spaces and parentheses.
+    Start = Content.rfind(')');
+    for (int Field = 3; Field <= 20 && Start != std::string_view::npos; ++Field) {
+      Start = Content.find(' ', Start + 1);
+    }
+    if (Start == std::string_view::npos) {
+      return -1;
+    }
+    ++Start;
+  }
+
+  uint32_t Threads {};
+  const auto [End, Error] = std::from_chars(Content.data() + Start, Content.data() + Content.size(), Threads);
+  if (Error != std::errc {}) {
+    return -1;
+  }
+  const auto Fixed = fextl::fmt::format("{}", Threads > Internal ? Threads - Internal : 1);
+
+  int FD = GenTmpFD(pathname, flags);
+  write(FD, Content.data(), Start);
+  write(FD, Fixed.data(), Fixed.size());
+  write(FD, End, Content.data() + Content.size() - End);
+  lseek(FD, 0, SEEK_SET);
+  SealTmpFD(FD);
+  return FD;
+}
