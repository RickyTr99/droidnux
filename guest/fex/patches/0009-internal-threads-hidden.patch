+// TIDs of the live internal threads. A fixed table so lookups never allocate or lock.
+// shortcut: an internal thread past the table's size stays visible to the guest, grow it if FEX ever runs more.
+static std::array<std::atomic<pid_t>, 16> InternalThreads {};
+
+static void RegisterInternalThread(pid_t TID) {
+  for (auto& Slot : InternalThreads) {
+    pid_t Free = 0;
+    if (Slot.compare_exchange_strong(Free, TID)) {
+      return;
+    }
+  }
+}
+
+static void UnregisterInternalThread(pid_t TID) {
+  for (auto& Slot : InternalThreads) {
+    pid_t Expected = TID;
+    if (Slot.compare_exchange_strong(Expected, 0)) {
+      return;
+    }
+  }
+}
+
+uint32_t InternalThreadCount() {
+  uint32_t Count = 0;
+  for (auto& Slot : InternalThreads) {
+    Count += Slot.load(std::memory_order_relaxed) != 0;
+  }
+  return Count;
+}
+
+bool IsInternalThread(pid_t TID) {
+  if (TID <= 0) {
+    return false;
+  }
+  for (auto& Slot : InternalThreads) {
+    if (Slot.load(std::memory_order_relaxed) == TID) {
+      return true;
+    }
+  }
+  return false;
+}
