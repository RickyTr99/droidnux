+/* DroidNux allocator protocol (display/src/main/cpp/core/allocator.h in
+ * DroidNux): one connection per buffer, a request, a reply with the
+ * buffer's dma-buf; the buffer lives until the connection is closed.
+ */
+#define DROIDNUX_AHB_MAGIC 0x41584e44 /* "DNXA" */
+#define DROIDNUX_AHB_VERSION 1
+
+struct droidnux_ahb_request {
+   uint32_t magic, version, width, height, drm_format;
+};
+
+struct droidnux_ahb_reply {
+   int32_t status; /* 0, or a negative errno */
+   uint32_t stride; /* bytes */
+   uint64_t size;
+};
+
+static int
+droidnux_ahb_connect(void)
+{
+   const char *path = getenv("DROIDNUX_AHB_SOCKET");
+   struct sockaddr_un addr = { .sun_family = AF_UNIX };
+   if (path == NULL || path[0] == '\0' || strlen(path) >= sizeof(addr.sun_path))
+      return -1;
+   strcpy(addr.sun_path, path);
+
+   int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+   if (fd < 0)
+      return -1;
+   if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+      close(fd);
+      return -1;
+   }
+   return fd;
+}
+
+/* Whether the swapchain's images can come from the DroidNux allocator:
+ * single-plane BGRA (DRM ARGB8888) the server can take as a linear buffer.
+ */
+static bool
+droidnux_ahb_usable(const VkSwapchainCreateInfoKHR *pCreateInfo,
+                    const uint64_t *modifiers, uint32_t modifier_count)
+{
+   if (pCreateInfo->imageFormat != VK_FORMAT_B8G8R8A8_UNORM &&
+       pCreateInfo->imageFormat != VK_FORMAT_B8G8R8A8_SRGB)
+      return false;
+   if (pCreateInfo->imageArrayLayers != 1)
+      return false;
+
+   bool linear = false;
+   for (uint32_t i = 0; i < modifier_count; i++)
+      linear |= modifiers[i] == DRM_FORMAT_MOD_LINEAR;
+   if (!linear)
+      return false;
+
+   int fd = droidnux_ahb_connect();
+   if (fd < 0)
+      return false;
+   close(fd);
+   return true;
+}
+
+/* Asks for a width x rows buffer; on success the image owns the connection
+ * and the dma-buf, replacing any it had.
+ */
+static VkResult
+droidnux_ahb_request(struct wsi_image *image, uint32_t width, uint32_t rows,
+                     uint32_t *stride)
+{
+   int conn = droidnux_ahb_connect();
+   if (conn < 0)
+      return vk_errorf(NULL, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "DroidNux allocator: cannot connect: %s", strerror(errno));
+
+   const struct droidnux_ahb_request request = {
+      .magic = DROIDNUX_AHB_MAGIC,
+      .version = DROIDNUX_AHB_VERSION,
+      .width = width,
+      .height = rows,
+      .drm_format = DRM_FORMAT_ARGB8888,
+   };
+   struct droidnux_ahb_reply reply = { .status = -EIO };
+   char control[CMSG_SPACE(sizeof(int))];
+   struct iovec iov = { .iov_base = &reply, .iov_len = sizeof(reply) };
+   struct msghdr msg = {
+      .msg_iov = &iov,
+      .msg_iovlen = 1,
+      .msg_control = control,
+      .msg_controllen = sizeof(control),
+   };
+   int fd = -1;
+
+   if (send(conn, &request, sizeof(request), MSG_NOSIGNAL) == sizeof(request) &&
+       recvmsg(conn, &msg, MSG_CMSG_CLOEXEC | MSG_WAITALL) == sizeof(reply)) {
+      struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg);
+      if (cmsg && cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SCM_RIGHTS)
+         memcpy(&fd, CMSG_DATA(cmsg), sizeof(fd));
+   }
+   if (reply.status != 0 || fd < 0) {
+      if (fd >= 0)
+         close(fd);
+      close(conn);
+      return vk_errorf(NULL, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "DroidNux allocator: no %ux%u buffer (%d)",
+                       request.width, request.height, reply.status);
+   }
+
+   if (image->droidnux_fd >= 0)
+      close(image->droidnux_fd);
+   if (image->droidnux_conn >= 0)
+      close(image->droidnux_conn);
+   image->droidnux_conn = conn;
+   image->droidnux_fd = fd;
+   image->droidnux_size = reply.size;
+   *stride = reply.stride;
+   return VK_SUCCESS;
+}
+
+VkResult
+wsi_droidnux_alloc_image(const struct wsi_swapchain *chain,
+                         const struct wsi_image_info *info,
+                         struct wsi_image *image)
+{
+   uint32_t stride;
+   VkResult result = droidnux_ahb_request(image, info->create.extent.width,
+                                          info->create.extent.height, &stride);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* The explicit layout CreateImage is about to read. */
+   struct wsi_image_info *mutable_info = (struct wsi_image_info *)info;
+   mutable_info->droidnux_plane = (VkSubresourceLayout) {
+      .offset = 0,
+      .size = image->droidnux_size,
+      .rowPitch = stride,
+   };
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_create_droidnux_image_mem(const struct wsi_swapchain *chain,
+                              const struct wsi_image_info *info,
+                              struct wsi_image *image)
+{
+   const struct wsi_device *wsi = chain->wsi;
+   VkResult result;
+
+   VkMemoryRequirements reqs;
+   wsi->GetImageMemoryRequirements(chain->device, image->image, &reqs);
+   if (reqs.size > image->droidnux_size) {
+      /* The driver pads the image (rows aligned): ask for enough rows. The
+       * row pitch depends only on the width, so the layout holds.
+       */
+      uint32_t pitch = info->droidnux_plane.rowPitch, stride;
+      uint32_t rows = (uint32_t)((reqs.size + pitch - 1) / pitch);
+      result = droidnux_ahb_request(image, info->create.extent.width, rows, &stride);
+      if (result != VK_SUCCESS)
+         return result;
+      if (stride != pitch)
+         return vk_errorf(NULL, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                          "DroidNux allocator: stride %u for %u rows, %u before",
+                          stride, rows, pitch);
+   }
+   if (reqs.size > image->droidnux_size)
+      return vk_errorf(NULL, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "DroidNux allocator: buffer of %llu bytes, image needs %llu",
+                       (unsigned long long)image->droidnux_size, (unsigned long long)reqs.size);
+
+   /* Vulkan owns the fd it imports. */
+   int import_fd = os_dupfd_cloexec(image->droidnux_fd);
+   if (import_fd < 0)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   const struct wsi_memory_allocate_info memory_wsi_info = {
+      .sType = VK_STRUCTURE_TYPE_WSI_MEMORY_ALLOCATE_INFO_MESA,
+      .pNext = NULL,
+      .implicit_sync = !info->explicit_sync && !chain->dma_buf_semaphore,
+      .dma_buf_sync_file = chain->dma_buf_semaphore,
+   };
+   const VkImportMemoryFdInfoKHR memory_import_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = &memory_wsi_info,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = import_fd,
+   };
+   const VkMemoryDedicatedAllocateInfo memory_dedicated_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &memory_import_info,
+      .image = image->image,
+      .buffer = VK_NULL_HANDLE,
+   };
+   const VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &memory_dedicated_info,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex =
+         wsi_select_device_memory_type(wsi, reqs.memoryTypeBits),
+   };
+   result = wsi->AllocateMemory(chain->device, &memory_info,
+                                &chain->alloc, &image->memory);
+   if (result != VK_SUCCESS) {
+      close(import_fd);
+      return result;
+   }
+
+   image->dma_buf_fd = os_dupfd_cloexec(image->droidnux_fd);
+   if (image->dma_buf_fd < 0)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   image->drm_modifier = DRM_FORMAT_MOD_LINEAR;
+   image->num_planes = 1;
+   image->sizes[0] = image->droidnux_size;
+   image->row_pitches[0] = info->droidnux_plane.rowPitch;
+   image->offsets[0] = 0;
+   return VK_SUCCESS;
+}
