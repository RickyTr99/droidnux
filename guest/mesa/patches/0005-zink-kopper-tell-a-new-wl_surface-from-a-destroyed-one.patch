zink/kopper: tell a new wl_surface from a destroyed one at the same address

Kopper shares a display target between drawables of the same window and
looks it up by the wl_surface pointer. Qt destroys a hidden popup's
wl_surface before its EGLSurface, whose swapchain lives on until the
popup is shown again; the new wl_surface often gets the freed proxy's
address, so the new EGLSurface reuses the old swapchain, which presents
to the old object id. By then the compositor gave that id to another
object, and the client is disconnected ("invalid arguments for
org_kde_kwin_contrast#427.set_region" from KWin, plasmashell exiting
after opening and closing the launcher by touch a few dozen times).

The loader now passes the wl_surface's protocol id too, and an entry
with another id is not reused; a display target replaced in the table
deinits without removing the new one.

diff --git a/src/gallium/include/kopper_interface.h b/src/gallium/include/kopper_interface.h
--- a/src/gallium/include/kopper_interface.h
+++ b/src/gallium/include/kopper_interface.h
@@ -99,6 +99,10 @@
    int initial_swap_interval;
    bool present_opaque;
    uint32_t compression;
+   /* Wayland: the wl_surface's protocol id. A wl_surface destroyed while its
+    * swapchain lives on can leave its address to a new one; the id tells them
+    * apart. */
+   uint32_t wl_surface_id;
 };
 
 #define __DRI_KOPPER_LOADER "DRI_KopperLoader"
diff --git a/src/egl/drivers/dri2/platform_wayland.c b/src/egl/drivers/dri2/platform_wayland.c
--- a/src/egl/drivers/dri2/platform_wayland.c
+++ b/src/egl/drivers/dri2/platform_wayland.c
@@ -2475,6 +2475,7 @@
     * queues and proxy wrappers.
     */
    wlsci->surface = dri2_surf->wayland_surface.surface;
+   out->wl_surface_id = wl_proxy_get_id((struct wl_proxy *)wlsci->surface);
    out->present_opaque = dri2_surf->base.PresentOpaque;
    /* convert to vulkan constants */
    switch (dri2_surf->base.CompressionRate) {
diff --git a/src/gallium/drivers/zink/zink_kopper.c b/src/gallium/drivers/zink/zink_kopper.c
--- a/src/gallium/drivers/zink/zink_kopper.c
+++ b/src/gallium/drivers/zink/zink_kopper.c
@@ -236,6 +236,10 @@
    case KOPPER_WAYLAND: {
       VkWaylandSurfaceCreateInfoKHR *wlsci = (VkWaylandSurfaceCreateInfoKHR *)&cdt->info.bos;
       he = _mesa_hash_table_search(&screen->dts, wlsci->surface);
+      /* Same address, another wl_surface: the registered one was destroyed
+       * and its swapchain must not present to the new one. */
+      if (he && ((struct kopper_displaytarget *)he->data)->info.wl_surface_id != cdt->info.wl_surface_id)
+         he = NULL;
       break;
    }
 #endif
@@ -259,10 +263,12 @@
       return;
    simple_mtx_lock(&screen->dt_lock);
    struct hash_entry *he = find_dt_entry(screen, cdt);
-   assert(he);
-   /* this deinits the registered entry, which should always be the "right" entry */
-   cdt = he->data;
-   _mesa_hash_table_remove(&screen->dts, he);
+   /* this deinits the registered entry, which should always be the "right" entry,
+    * unless a new wl_surface at the same address replaced it */
+   if (he) {
+      cdt = he->data;
+      _mesa_hash_table_remove(&screen->dts, he);
+   }
    simple_mtx_unlock(&screen->dt_lock);
    struct kopper_swapchain *cswap = cdt->swapchain;
    cdt->swapchain = NULL;
