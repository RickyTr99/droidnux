turnip/kgsl: poll timestamps without waiting for them

A zero timeout (vkWaitSemaphores or vkGetFenceStatus polling) becomes an
IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID with a 0 ms timeout, and KGSL then
waits until the timestamp retires. Zink polls for finished batches after
every submit on its flush thread, and synchronous flushes (glFenceSync,
EGL native fences) wait for that thread: every frame of a GL compositor
on Zink (KWin) blocked for its GPU work, about 5 ms at 120 Hz. Read the
retired timestamp instead when there is no time to wait.

--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -793,6 +793,19 @@
       .timeout = get_relative_ms(abs_timeout_ns),
    };

+   /* A poll (zink checks for finished batches after every submit): KGSL's
+    * wait with a 0 ms timeout blocks until the timestamp retires, so read the
+    * retired timestamp instead.
+    */
+   if (wait.timeout == 0) {
+      struct kgsl_cmdstream_readtimestamp_ctxtid retired = {
+         .context_id = context_id,
+         .type = KGSL_TIMESTAMP_RETIRED,
+      };
+      if (safe_ioctl(fd, IOCTL_KGSL_CMDSTREAM_READTIMESTAMP_CTXTID, &retired) == 0)
+         return timestamp_cmp(retired.timestamp, timestamp) ? VK_SUCCESS : VK_TIMEOUT;
+   }
+
    while (true) {
       int ret = ioctl(fd, IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID, &wait);

