+/* DroidNux: the app moves this file's mtime a second past the user's latest
+ * input, and until then the queue asks KGSL for the GPU's highest clock.
+ * KGSL's governor alone keeps a desktop's frames at the lowest one (the GPU
+ * is about 60% busy there, too little to ramp up) and they miss the vsync;
+ * boosting outside input costs a lot of power for animations nobody drives.
+ */
+#define KGSL_BOOST_FILE "/tmp/.droidnux-gpu-boost"
+
+static void
+kgsl_queue_update_boost(struct tu_queue *queue)
+{
+   struct timespec now;
+   clock_gettime(CLOCK_REALTIME, &now);
+   int64_t now_ns = timespec_to_nsec(&now);
+   /* A stat per submit would be wasted work. */
+   if (now_ns - queue->kgsl_boost_checked < 10000000)
+      return;
+   queue->kgsl_boost_checked = now_ns;
+
+   struct stat st;
+   bool boost = stat(KGSL_BOOST_FILE, &st) == 0 &&
+                (int64_t) timespec_to_nsec(&st.st_mtim) > now_ns;
+   if (boost == queue->kgsl_boosted)
+      return;
+   queue->kgsl_boosted = boost;
+
+   struct kgsl_device_constraint_pwrlevel level = {
+      .level = KGSL_CONSTRAINT_PWR_MAX,
+   };
+   struct kgsl_device_constraint constraint = {
+      .type = boost ? KGSL_CONSTRAINT_PWRLEVEL : KGSL_CONSTRAINT_NONE,
+      .context_id = queue->msm_queue_id,
+      .data = &level,
+      .size = sizeof(level),
+   };
+   struct kgsl_device_getproperty prop = {
+      .type = KGSL_PROP_PWR_CONSTRAINT,
+      .value = &constraint,
+      .sizebytes = sizeof(constraint),
+   };
+   safe_ioctl(queue->device->physical_device->local_fd,
+              IOCTL_KGSL_SETPROPERTY, &prop);
+}
+
 static void kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo);
 
 static VkResult
