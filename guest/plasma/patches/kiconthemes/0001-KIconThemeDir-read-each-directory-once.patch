+bool KIconThemeDir::mayContain(const QString &name) const
+{
+    if (mBaseDir.startsWith(QLatin1Char(':'))) {
+        return true; // a theme in resources: no directory to read
+    }
+
+    QMutexLocker locker(&mEntriesMutex);
+    if (!mEntriesAge.isValid() || mEntriesAge.hasExpired(10000)) {
+        mEntries.clear();
+        if (DIR *dir = opendir(QFile::encodeName(constructFileName(QString())).constData())) {
+            while (const dirent *entry = readdir(dir)) {
+                mEntries.insert(qHash(QByteArrayView(entry->d_name)));
+            }
+            closedir(dir);
+        }
+        mEntriesAge.start();
+    }
+    return mEntries.contains(qHash(QByteArrayView(QFile::encodeName(name))));
+}
