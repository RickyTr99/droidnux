+// Android's storage, where an app sees neither block devices (udisks, /sys/block,
+// /proc/diskstats) nor the other apps: the space of the root file system, and the
+// bytes the processes it can see read and write.
+class StorageObject : public KSysGuard::SensorObject
+{
+    Q_OBJECT
+public:
+    StorageObject(KSysGuard::SensorContainer *parent);
+    void update();
+    void countBytes(qint64 elapsed);
+
+private:
+    KSysGuard::SensorProperty *m_total = nullptr;
+    KSysGuard::SensorProperty *m_used = nullptr;
+    KSysGuard::SensorProperty *m_free = nullptr;
+    KSysGuard::SensorProperty *m_readRate = nullptr;
+    KSysGuard::SensorProperty *m_writeRate = nullptr;
+    QHash<int, QPair<quint64, quint64>> m_processBytes; // read, written
+};
+
+StorageObject::StorageObject(KSysGuard::SensorContainer *parent)
+    : SensorObject(QStringLiteral("internal"), i18nc("@title", "Internal Storage"), parent)
+{
+    auto name = new KSysGuard::SensorProperty("name", i18nc("@title", "Name"), this->name(), this);
+    name->setShortName(i18nc("@title", "Name"));
+    name->setVariantType(QVariant::String);
+
+    m_total = new KSysGuard::SensorProperty("total", i18nc("@title", "Total Space"), 0, this);
+    m_total->setPrefix(this->name());
+    m_total->setShortName(i18nc("@title Short for 'Total Space'", "Total"));
+    m_total->setUnit(KSysGuard::UnitByte);
+    m_total->setVariantType(QVariant::ULongLong);
+
+    m_used = new KSysGuard::SensorProperty("used", i18nc("@title", "Used Space"), this);
+    m_used->setPrefix(this->name());
+    m_used->setShortName(i18nc("@title Short for 'Used Space'", "Used"));
+    m_used->setUnit(KSysGuard::UnitByte);
+    m_used->setVariantType(QVariant::ULongLong);
+
+    m_free = new KSysGuard::SensorProperty("free", i18nc("@title", "Free Space"), this);
+    m_free->setPrefix(this->name());
+    m_free->setShortName(i18nc("@title Short for 'Free Space'", "Free"));
+    m_free->setUnit(KSysGuard::UnitByte);
+    m_free->setVariantType(QVariant::ULongLong);
+
+    m_readRate = new KSysGuard::SensorProperty("read", i18nc("@title", "Read Rate"), 0, this);
+    m_readRate->setPrefix(this->name());
+    m_readRate->setShortName(i18nc("@title Short for 'Read Rate'", "Read"));
+    m_readRate->setUnit(KSysGuard::UnitByteRate);
+    m_readRate->setVariantType(QVariant::Double);
+
+    m_writeRate = new KSysGuard::SensorProperty("write", i18nc("@title", "Write Rate"), 0, this);
+    m_writeRate->setPrefix(this->name());
+    m_writeRate->setShortName(i18nc("@title Short for 'Write Rate'", "Write"));
+    m_writeRate->setUnit(KSysGuard::UnitByteRate);
+    m_writeRate->setVariantType(QVariant::Double);
+
+    auto usedPercent = new KSysGuard::PercentageSensor(this, "usedPercent", i18nc("@title", "Percentage Used"));
+    usedPercent->setPrefix(this->name());
+    usedPercent->setBaseSensor(m_used);
+
+    auto freePercent = new KSysGuard::PercentageSensor(this, "freePercent", i18nc("@title", "Percentage Free"));
+    freePercent->setPrefix(this->name());
+    freePercent->setBaseSensor(m_free);
+
+    update();
+}
+
+void StorageObject::update()
+{
+    struct statvfs fs;
+    if (statvfs("/", &fs) != 0) {
+        return;
+    }
+    const quint64 size = quint64(fs.f_blocks) * fs.f_frsize;
+    const quint64 available = quint64(fs.f_bavail) * fs.f_frsize;
+    m_total->setValue(size);
+    m_free->setValue(available);
+    m_free->setMax(size);
+    m_used->setValue(size - available);
+    m_used->setMax(size);
+}
+
+void StorageObject::countBytes(qint64 elapsed)
+{
+    // Processes that end between two updates lose their last bytes.
+    const bool first = m_processBytes.isEmpty();
+    QHash<int, QPair<quint64, quint64>> now;
+    quint64 read = 0;
+    quint64 written = 0;
+    const auto entries = QDir(QStringLiteral("/proc")).entryList(QDir::Dirs | QDir::NoDotAndDotDot);
+    for (const auto &entry : entries) {
+        bool ok = false;
+        const int pid = entry.toInt(&ok);
+        if (!ok) {
+            continue;
+        }
+        QFile io(QStringLiteral("/proc/%1/io").arg(entry));
+        if (!io.open(QIODevice::ReadOnly | QIODevice::Text)) {
+            continue;
+        }
+        QPair<quint64, quint64> bytes{0, 0};
+        for (QByteArray line = io.readLine(); !line.isNull(); line = io.readLine()) {
+            if (line.startsWith("read_bytes:")) {
+                bytes.first = line.mid(11).trimmed().toULongLong();
+            } else if (line.startsWith("write_bytes:")) {
+                bytes.second = line.mid(12).trimmed().toULongLong();
+            }
+        }
+        const auto before = m_processBytes.value(pid, first ? bytes : QPair<quint64, quint64>{0, 0});
+        read += bytes.first > before.first ? bytes.first - before.first : 0;
+        written += bytes.second > before.second ? bytes.second - before.second : 0;
+        now.insert(pid, bytes);
+    }
+    m_processBytes = now;
+    if (elapsed != 0) {
+        m_readRate->setValue(read / (elapsed / 1000.0));
+        m_writeRate->setValue(written / (elapsed / 1000.0));
+    }
+}
+
 DisksPlugin::DisksPlugin(QObject *parent, const QVariantList &args)
     : SensorPlugin(parent, args)
 {
@@ -182,6 +306,12 @@ DisksPlugin::DisksPlugin(QObject *parent, const QVariantList &args)
             }
         }
     });
+#ifdef Q_OS_LINUX
+    QFile diskstats(QStringLiteral("/proc/diskstats"));
+    if (m_volumesByDevice.isEmpty() && !diskstats.open(QIODevice::ReadOnly)) { // there, but refused
+        m_storage = new StorageObject(container);
+    }
+#endif
     addAggregateSensors();
 #ifdef Q_OS_FREEBSD
     geom_stats_open();
@@ -336,6 +466,10 @@ void DisksPlugin::update()
             volume->update();
         }
     }
+    if (m_storage && m_storage->isSubscribed()) {
+        anySubscribed = true;
+        m_storage->update();
+    }
 
     if (!anySubscribed) {
         return;
@@ -347,6 +481,9 @@ void DisksPlugin::update()
     } else {
         m_elapsedTimer.start();
     }
+    if (m_storage) {
+        m_storage->countBytes(elapsed);
+    }
 #if defined Q_OS_LINUX
     QFile diskstats("/proc/diskstats");
     if (!diskstats.exists()) {
