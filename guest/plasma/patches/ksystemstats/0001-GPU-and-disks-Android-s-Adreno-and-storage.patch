diff --git a/plugins/gpu/LinuxBackend.cpp b/plugins/gpu/LinuxBackend.cpp
index cd647f7..abe565a 100644
--- a/plugins/gpu/LinuxBackend.cpp
+++ b/plugins/gpu/LinuxBackend.cpp
@@ -8,10 +8,12 @@
 
 #include <KLocalizedString>
 #include <QDebug>
+#include <QFile>
 
 #include <libudev.h>
 
 #include "LinuxAmdGpu.h"
+#include "LinuxKgslGpu.h"
 #include "LinuxNvidiaGpu.h"
 #include "debug.h"
 
@@ -73,6 +75,15 @@ void LinuxBackend::start()
     }
 
     udev_enumerate_unref(enumerate);
+
+    // Android's Adreno: no DRM device, and no udev.
+    const auto kgslPath = QStringLiteral("/sys/class/kgsl/kgsl-3d0");
+    if (m_devices.isEmpty() && QFile::exists(kgslPath + QStringLiteral("/gpu_busy_percentage"))) {
+        auto gpu = new LinuxKgslGpu{QStringLiteral("gpu0"), i18nc("@title %1 is GPU number", "GPU %1", 1), kgslPath};
+        gpu->initialize();
+        m_devices.append(gpu);
+        Q_EMIT deviceAdded(gpu);
+    }
 }
 
 void LinuxBackend::stop()
diff --git a/plugins/gpu/LinuxKgslGpu.cpp b/plugins/gpu/LinuxKgslGpu.cpp
new file mode 100644
index 0000000..1265449
--- /dev/null
+++ b/plugins/gpu/LinuxKgslGpu.cpp
@@ -0,0 +1,57 @@
+/*
+ * SPDX-FileCopyrightText: 2026 DroidNux
+ *
+ * SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+ */
+
+#include "LinuxKgslGpu.h"
+
+#include <QFile>
+#include <QRegularExpression>
+
+static QByteArray readValue(const QString &path)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    return file.readAll().trimmed();
+}
+
+LinuxKgslGpu::LinuxKgslGpu(const QString &id, const QString &name, const QString &sysPath)
+    : GpuDevice(id, name)
+    , m_sysPath(sysPath)
+{
+}
+
+void LinuxKgslGpu::initialize()
+{
+    GpuDevice::initialize();
+
+    // "Adreno740v2": "Adreno 740"
+    const auto model = QString::fromLatin1(readValue(m_sysPath + QStringLiteral("/gpu_model")));
+    const auto match = QRegularExpression(QStringLiteral("^Adreno(\\d+)")).match(model);
+    if (match.hasMatch()) {
+        m_nameProperty->setValue(QStringLiteral("Adreno %1").arg(match.captured(1)));
+    } else if (!model.isEmpty()) {
+        m_nameProperty->setValue(model);
+    }
+
+    bool ok = false;
+    const auto maxFrequency = readValue(m_sysPath + QStringLiteral("/devfreq/max_freq")).toULongLong(&ok);
+    if (ok) {
+        m_coreFrequencyProperty->setMax(maxFrequency / 1000000);
+    }
+}
+
+void LinuxKgslGpu::update()
+{
+    // "12 %"
+    m_usageProperty->setValue(readValue(m_sysPath + QStringLiteral("/gpu_busy_percentage")).split(' ').value(0).toInt());
+    // Hz
+    m_coreFrequencyProperty->setValue(readValue(m_sysPath + QStringLiteral("/devfreq/cur_freq")).toULongLong() / 1000000);
+    // Millidegrees
+    m_temperatureProperty->setValue(readValue(m_sysPath + QStringLiteral("/temp")).toInt() / 1000.0);
+}
+
+#include "moc_LinuxKgslGpu.cpp"
diff --git a/plugins/gpu/LinuxKgslGpu.h b/plugins/gpu/LinuxKgslGpu.h
new file mode 100644
index 0000000..a46d446
--- /dev/null
+++ b/plugins/gpu/LinuxKgslGpu.h
@@ -0,0 +1,25 @@
+/*
+ * SPDX-FileCopyrightText: 2026 DroidNux
+ *
+ * SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+ */
+
+#pragma once
+
+#include "GpuDevice.h"
+
+// Qualcomm's Adreno through its KGSL driver (Android), which has no DRM device:
+// its sysfs directory, /sys/class/kgsl/kgsl-3d0.
+class LinuxKgslGpu : public GpuDevice
+{
+    Q_OBJECT
+
+public:
+    LinuxKgslGpu(const QString &id, const QString &name, const QString &sysPath);
+
+    void initialize() override;
+    void update() override;
+
+private:
+    const QString m_sysPath;
+};
