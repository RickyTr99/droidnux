 struct wl_buffer;
 struct wl_display;
@@ -56,6 +57,112 @@ class WaylandOutput;
 class WaylandEglBackend;
 class WaylandDisplay;
 
+/**
+ * The pointer's settings on D-Bus, under the interface the libinput backend gives its devices:
+ * Plasma's mouse settings find a mouse to set. Nested in DroidNux's compositor the pointer is
+ * that compositor's: the wheel's settings apply here, the buttons' and the speed in DroidNux,
+ * which reads them from the file DROIDNUX_POINTER_SETTINGS names.
+ */
+class WaylandPointerSettings : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.KWin.InputDevice")
+    Q_PROPERTY(QString name READ name CONSTANT)
+    Q_PROPERTY(QString sysName READ sysName CONSTANT)
+    Q_PROPERTY(bool pointer READ yes CONSTANT)
+    Q_PROPERTY(bool touchpad READ no CONSTANT)
+    Q_PROPERTY(bool supportsDisableEvents READ no CONSTANT)
+    Q_PROPERTY(bool enabled READ yes WRITE ignore)
+    Q_PROPERTY(int supportedButtons READ supportedButtons CONSTANT)
+    Q_PROPERTY(bool supportsLeftHanded READ yes CONSTANT)
+    Q_PROPERTY(bool leftHandedEnabledByDefault READ no CONSTANT)
+    Q_PROPERTY(bool leftHanded MEMBER m_leftHanded NOTIFY changed)
+    Q_PROPERTY(bool supportsMiddleEmulation READ no CONSTANT)
+    Q_PROPERTY(bool middleEmulationEnabledByDefault READ no CONSTANT)
+    Q_PROPERTY(bool middleEmulation READ no WRITE ignore)
+    Q_PROPERTY(bool supportsPointerAcceleration READ yes CONSTANT)
+    Q_PROPERTY(qreal defaultPointerAcceleration READ zero CONSTANT)
+    Q_PROPERTY(qreal pointerAcceleration MEMBER m_pointerAcceleration NOTIFY changed)
+    // The speed alone: DroidNux has no acceleration curve.
+    Q_PROPERTY(bool supportsPointerAccelerationProfileFlat READ yes CONSTANT)
+    Q_PROPERTY(bool defaultPointerAccelerationProfileFlat READ yes CONSTANT)
+    Q_PROPERTY(bool pointerAccelerationProfileFlat READ yes WRITE ignore)
+    Q_PROPERTY(bool supportsPointerAccelerationProfileAdaptive READ no CONSTANT)
+    Q_PROPERTY(bool defaultPointerAccelerationProfileAdaptive READ no CONSTANT)
+    Q_PROPERTY(bool pointerAccelerationProfileAdaptive READ no WRITE ignore)
+    Q_PROPERTY(bool supportsNaturalScroll READ yes CONSTANT)
+    Q_PROPERTY(bool naturalScrollEnabledByDefault READ no CONSTANT)
+    Q_PROPERTY(bool naturalScroll MEMBER m_naturalScroll NOTIFY changed)
+    Q_PROPERTY(qreal scrollFactor MEMBER m_scrollFactor NOTIFY changed)
+    Q_PROPERTY(bool supportsScrollOnButtonDown READ no CONSTANT)
+    Q_PROPERTY(bool scrollOnButtonDownEnabledByDefault READ no CONSTANT)
+    Q_PROPERTY(bool scrollOnButtonDown READ no WRITE ignore)
+
+public:
+    explicit WaylandPointerSettings(QObject *parent = nullptr);
+
+    QString name() const;
+    QString sysName() const;
+    int supportedButtons() const;
+    bool naturalScroll() const
+    {
+        return m_naturalScroll;
+    }
+    qreal scrollFactor() const
+    {
+        return m_scrollFactor;
+    }
+
+Q_SIGNALS:
+    void changed();
+
+private:
+    bool yes() const
+    {
+        return true;
+    }
+    bool no() const
+    {
+        return false;
+    }
+    qreal zero() const
+    {
+        return 0;
+    }
+    void ignore(bool)
+    {
+    }
+    void save();
+    void writeFile() const;
+
+    bool m_leftHanded = false;
+    bool m_naturalScroll = false;
+    qreal m_pointerAcceleration = 0;
+    qreal m_scrollFactor = 1;
+};
+
+/**
+ * The list of devices Plasma's settings ask the libinput backend for: the one pointer.
+ */
+class WaylandPointerSettingsList : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.KWin.InputDeviceManager")
+    Q_PROPERTY(QStringList devicesSysNames READ devicesSysNames CONSTANT)
+
+public:
+    explicit WaylandPointerSettingsList(WaylandPointerSettings *settings);
+
+    QStringList devicesSysNames() const;
+
+Q_SIGNALS:
+    void deviceAdded(QString sysName);
+    void deviceRemoved(QString sysName);
+
+private:
+    WaylandPointerSettings *const m_settings;
+};
+
 class WaylandInputDevice : public InputDevice
 {
     Q_OBJECT
@@ -92,6 +199,7 @@ private:
     std::unique_ptr<KWayland::Client::Pointer> m_pointer;
     std::unique_ptr<KWayland::Client::PointerPinchGesture> m_pinchGesture;
     std::unique_ptr<KWayland::Client::PointerSwipeGesture> m_swipeGesture;
+    std::unique_ptr<WaylandPointerSettings> m_settings;
 
     QSet<quint32> m_pressedKeys;
     PointerAxisSource m_axisSource = PointerAxisSource::Unknown;
