Subject: [PATCH] Wayland backend: the pointer's settings

The nested backend has no libinput devices, so Plasma's mouse settings
found none ("Querying input devices failed"). The pointer now has the
libinput backend's D-Bus objects: the wheel's direction and speed apply
here, left-handed buttons and the pointer's speed in DroidNux, which turns
Android's events into the pointer's and reads them from the file
DROIDNUX_POINTER_SETTINGS names.
---
diff --git a/src/backends/wayland/wayland_backend.cpp b/src/backends/wayland/wayland_backend.cpp
index f0bf15f..a562a49 100644
--- a/src/backends/wayland/wayland_backend.cpp
+++ b/src/backends/wayland/wayland_backend.cpp
@@ -24,7 +24,12 @@
 #include <KWayland/Client/surface.h>
 #include <KWayland/Client/touch.h>
 
+#include <KConfigGroup>
+#include <KSharedConfig>
+
 #include <QAbstractEventDispatcher>
+#include <QDBusConnection>
+#include <QSaveFile>
 
 #include <drm_fourcc.h>
 #include <fcntl.h>
@@ -47,6 +52,85 @@ inline static QPointF sizeToPoint(const QSizeF &size)
     return QPointF(size.width(), size.height());
 }
 
+// Where the libinput backend keeps a device's settings, under a name of ours.
+static KConfigGroup pointerSettingsGroup()
+{
+    return KSharedConfig::openConfig(QStringLiteral("kcminputrc"))->group(QStringLiteral("Libinput")).group(QStringLiteral("DroidNux")).group(QStringLiteral("Mouse"));
+}
+
+WaylandPointerSettings::WaylandPointerSettings(QObject *parent)
+    : QObject(parent)
+{
+    const KConfigGroup group = pointerSettingsGroup();
+    m_leftHanded = group.readEntry("LeftHanded", m_leftHanded);
+    m_naturalScroll = group.readEntry("NaturalScroll", m_naturalScroll);
+    m_pointerAcceleration = group.readEntry("PointerAcceleration", m_pointerAcceleration);
+    m_scrollFactor = group.readEntry("ScrollFactor", m_scrollFactor);
+    writeFile();
+    connect(this, &WaylandPointerSettings::changed, this, &WaylandPointerSettings::save);
+
+    QDBusConnection::sessionBus().registerObject(QStringLiteral("/org/kde/KWin/InputDevice"),
+                                                 new WaylandPointerSettingsList(this),
+                                                 QDBusConnection::ExportAllProperties | QDBusConnection::ExportAllSignals);
+    QDBusConnection::sessionBus().registerObject(QStringLiteral("/org/kde/KWin/InputDevice/") + sysName(),
+                                                 this,
+                                                 QDBusConnection::ExportAllProperties);
+}
+
+QString WaylandPointerSettings::name() const
+{
+    return QStringLiteral("Mouse");
+}
+
+QString WaylandPointerSettings::sysName() const
+{
+    // An object path's element, as libinput's names are.
+    return QStringLiteral("event0");
+}
+
+int WaylandPointerSettings::supportedButtons() const
+{
+    return (Qt::LeftButton | Qt::MiddleButton | Qt::RightButton | Qt::BackButton | Qt::ForwardButton).toInt();
+}
+
+void WaylandPointerSettings::save()
+{
+    KConfigGroup group = pointerSettingsGroup();
+    group.writeEntry("LeftHanded", m_leftHanded);
+    group.writeEntry("NaturalScroll", m_naturalScroll);
+    group.writeEntry("PointerAcceleration", m_pointerAcceleration);
+    group.writeEntry("ScrollFactor", m_scrollFactor);
+    group.sync();
+    writeFile();
+}
+
+void WaylandPointerSettings::writeFile() const
+{
+    const QString path = qEnvironmentVariable("DROIDNUX_POINTER_SETTINGS");
+    if (path.isEmpty()) {
+        return;
+    }
+    // Renamed into place: DroidNux reads it whole.
+    QSaveFile file(path);
+    if (file.open(QIODevice::WriteOnly)) {
+        QByteArray settings("leftHanded=");
+        settings.append(m_leftHanded ? "true" : "false").append("\npointerAcceleration=").append(QByteArray::number(m_pointerAcceleration)).append('\n');
+        file.write(settings);
+        file.commit();
+    }
+}
+
+WaylandPointerSettingsList::WaylandPointerSettingsList(WaylandPointerSettings *settings)
+    : QObject(settings)
+    , m_settings(settings)
+{
+}
+
+QStringList WaylandPointerSettingsList::devicesSysNames() const
+{
+    return {m_settings->sysName()};
+}
+
 WaylandInputDevice::WaylandInputDevice(KWayland::Client::Keyboard *keyboard, WaylandSeat *seat)
     : m_seat(seat)
     , m_keyboard(keyboard)
@@ -81,6 +165,7 @@ WaylandInputDevice::WaylandInputDevice(KWayland::Client::Keyboard *keyboard, Way
 WaylandInputDevice::WaylandInputDevice(KWayland::Client::Pointer *pointer, WaylandSeat *seat)
     : m_seat(seat)
     , m_pointer(pointer)
+    , m_settings(std::make_unique<WaylandPointerSettings>())
 {
     connect(pointer, &Pointer::entered, this, [this](quint32 serial, const QPointF &relativeToSurface) {
         WaylandOutput *output = m_seat->backend()->findOutput(m_pointer->enteredSurface());
@@ -152,7 +237,10 @@ WaylandInputDevice::WaylandInputDevice(KWayland::Client::Pointer *pointer, Wayla
             Q_UNREACHABLE();
         }
         qint32 &discrete = m_axisDiscrete[axis == PointerAxis::Vertical ? 1 : 0];
-        Q_EMIT pointerAxisChanged(axis, delta, discrete * 120, m_axisSource, false, std::chrono::milliseconds(time), this);
+        // The wheel's settings; a touchpad scrolls as DroidNux's compositor has it.
+        const bool inverted = m_axisSource == PointerAxisSource::Wheel && m_settings->naturalScroll();
+        const qreal factor = m_axisSource == PointerAxisSource::Wheel ? m_settings->scrollFactor() * (inverted ? -1 : 1) : 1;
+        Q_EMIT pointerAxisChanged(axis, delta * factor, qRound(discrete * 120 * factor), m_axisSource, inverted, std::chrono::milliseconds(time), this);
         discrete = 0;
     });
 
diff --git a/src/backends/wayland/wayland_backend.h b/src/backends/wayland/wayland_backend.h
index 8156994..569d6ca 100644
--- a/src/backends/wayland/wayland_backend.h
+++ b/src/backends/wayland/wayland_backend.h
@@ -23,6 +23,7 @@
 #include <QObject>
 #include <QPoint>
 #include <QSize>
