Subject: [PATCH] Wayland backend: the output's orientation

Plasma's display settings could turn the nested output, but the backend
rendered it unturned and the host showed it stretched. A turned output now
renders turned, as the DRM backend does for a turned panel, and tells the
host with wl_surface.set_buffer_transform; its mode is the window's size
turned, so the output keeps the window's shape. The orientation goes to
the file DROIDNUX_ORIENTATION names: DroidNux turns the device's screen to
match.
---
diff --git a/src/backends/wayland/wayland_egl_backend.cpp b/src/backends/wayland/wayland_egl_backend.cpp
index 9576b62..a36a811 100644
--- a/src/backends/wayland/wayland_egl_backend.cpp
+++ b/src/backends/wayland/wayland_egl_backend.cpp
@@ -86,6 +86,12 @@ std::optional<OutputLayerBeginFrameInfo> WaylandEglPrimaryLayer::doBeginFrame()
     if (!m_buffer) {
         return std::nullopt;
     }
+    // Rendered turned, as the DRM backend does for a turned panel; the output tells the host.
+    const OutputTransform contentTransform = m_output->transform().combine(OutputTransform::FlipY);
+    if (m_buffer->framebuffer()->colorAttachment()->contentTransform() != contentTransform) {
+        m_damageJournal.clear();
+    }
+    m_buffer->framebuffer()->colorAttachment()->setContentTransform(contentTransform);
 
     const QRegion repair = bufferAgeEnabled ? m_damageJournal.accumulate(m_buffer->age(), infiniteRegion()) : infiniteRegion();
     m_query = std::make_unique<GLRenderTimeQuery>(m_backend->openglContextRef());
diff --git a/src/backends/wayland/wayland_output.cpp b/src/backends/wayland/wayland_output.cpp
index 4e6a311..634c650 100644
--- a/src/backends/wayland/wayland_output.cpp
+++ b/src/backends/wayland/wayland_output.cpp
@@ -23,10 +23,12 @@
 #include <KWayland/Client/xdgdecoration.h>
 
 #include "wayland-presentation-time-client-protocol.h"
+#include <wayland-client-protocol.h>
 
 #include <KLocalizedString>
 
 #include <QPainter>
+#include <QSaveFile>
 
 #include <cmath>
 
@@ -201,6 +203,8 @@ void WaylandOutput::present(const std::shared_ptr<OutputFrame> &frame)
     m_surface->attachBuffer(m_presentationBuffer);
     m_surface->damage(frame->damage());
     m_surface->setScale(std::ceil(scale()));
+    // Rendered turned, as for a turned panel: the host turns it back.
+    wl_surface_set_buffer_transform(*m_surface, transform().kind());
     m_presentationBuffer = nullptr;
     if (auto presentationTime = m_backend->display()->presentationTime()) {
         m_presentationFeedback = wp_presentation_feedback(presentationTime, *m_surface);
@@ -226,7 +230,7 @@ void WaylandOutput::framePresented(std::chrono::nanoseconds timestamp, uint32_t
 {
     if (refreshRate != this->refreshRate()) {
         m_refreshRate = refreshRate;
-        const auto mode = std::make_shared<OutputMode>(pixelSize(), m_refreshRate);
+        const auto mode = std::make_shared<OutputMode>(modeSize(), m_refreshRate);
         State next = m_state;
         next.modes = {mode};
         next.currentMode = mode;
@@ -295,14 +299,20 @@ void WaylandOutput::init(const QSize &pixelSize, qreal scale)
 
 void WaylandOutput::resize(const QSize &pixelSize)
 {
-    auto mode = std::make_shared<OutputMode>(pixelSize, m_refreshRate);
+    setWindowSize(pixelSize);
+
+    Q_EMIT m_backend->outputsQueried();
+}
+
+void WaylandOutput::setWindowSize(const QSize &pixelSize)
+{
+    // The window's size is the turned output's: the mode is the panel's.
+    auto mode = std::make_shared<OutputMode>(orientateSize(pixelSize), m_refreshRate);
 
     State next = m_state;
     next.modes = {mode};
     next.currentMode = mode;
     setState(next);
-
-    Q_EMIT m_backend->outputsQueried();
 }
 
 void WaylandOutput::setDpmsMode(DpmsMode mode)
@@ -352,8 +362,16 @@ void WaylandOutput::setBrightnessDevice(BrightnessDevice *device)
 
 void WaylandOutput::applyChanges(const OutputConfiguration &config)
 {
+    const QSize windowSize = pixelSize();
+    const OutputTransform oldTransform = transform();
     Output::applyChanges(config);
     const auto props = config.constChangeSet(this);
+    if (transform() != oldTransform) {
+        // Not resize(): outputs queried again would take back the stored configuration, which
+        // kscreen only saves once the user keeps this one.
+        setWindowSize(windowSize);
+        saveOrientation();
+    }
     if (!props || !props->brightness) {
         return;
     }
@@ -366,6 +384,21 @@ void WaylandOutput::applyChanges(const OutputConfiguration &config)
     }
 }
 
+void WaylandOutput::saveOrientation()
+{
+    // DroidNux turns the device's screen to match: a window turned with it
+    // brings the output back to the window's shape.
+    const QString path = qEnvironmentVariable("DROIDNUX_ORIENTATION");
+    if (path.isEmpty()) {
+        return;
+    }
+    QSaveFile file(path);
+    if (file.open(QIODevice::WriteOnly)) {
+        file.write(QByteArray::number(int(transform().kind())).append('\n'));
+        file.commit();
+    }
+}
+
 void WaylandOutput::handleConfigure(const QSize &size, XdgShellSurface::States states, quint32 serial)
 {
     if (!m_ready) {
